@model List<string>

@{
    ViewData["Title"] = "Gerador de Etiquetas";
}

<div class="container mt-4 d-print-none">
    <h4>Gerador de Etiquetas (50x10mm)</h4>
    <div class="row g-3 bg-light p-3 rounded">
        <div class="col-md-4">
            <label>Selecione a Máquina:</label>
            <select id="selectMaquina" class="form-select">
                @foreach (var m in Model)
                {
                    <option value="@m">@m</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label>Qtd Slots:</label>
            <input type="number" id="qtdSlots" class="form-control" value="50" min="1" max="100">
        </div>
        <div class="col-md-3 pt-4">
            <button class="btn btn-primary" onclick="gerarEtiquetas()">Gerar Visualização</button>
            <button class="btn btn-success" onclick="window.print()">Imprimir</button>
        </div>
    </div>
</div>

<div id="printArea" class="mt-4"></div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

    <style>
        /* CSS para impressão perfeita */
        @@media print {
            .d-print-none {
                display: none !important;
            }

            #printArea {
                display: flex;
                flex-wrap: wrap;
            }
        }

        .etiqueta {
            width: 50mm;
            height: 10mm;
            border: 1px solid #ccc;
            display: flex;
            align-items: center;
            padding: 1mm; /* Ajustado para mm */
            margin: 1mm;
            box-sizing: border-box; /* ESSENCIAL para o padding não somar no tamanho */
            overflow: hidden;
            flex-shrink: 0;
            float: left;
        }

        .qr-code {
            width: 8mm;
            height: 8mm;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            box-sizing: border-box;
            overflow: hidden; /* Garante que a imagem não saia da área */
        }

            /* FIX: Garante que a imagem gerada pela biblioteca respeite o tamanho do container */
            .qr-code img {
                display: block;
                width: 100%;
                height: 100%;
            }

        .texto {
            margin-left: 2mm;
            display: flex;
            align-items: center;
            gap: 2mm;
            white-space: nowrap;
            line-height: 1;
        }

            .texto strong {
                font-size: 12px;
                font-weight: 700;
            }

        .slot-label {
            display: inline-block;
            font-size: 30px;
            font-weight: 800;
            line-height: 1;
            margin-left: 5mm; /* joga o Slot para a direita */
        }
    </style>

    <script>
        function gerarEtiquetas() {
                const maquina = $('#selectMaquina').val();
                const qtd = $('#qtdSlots').val();
                const container = $('#printArea');
                container.empty();

                for (let i = 1; i <= qtd; i++) {
                    const slotId = "slot_" + i;
                    const slotTexto = i.toString().padStart(2, '0');
                    const labelData = `${maquina} / ${slotTexto}`;

                    // Cria o elemento da etiqueta
                    container.append(`
                        <div class="etiqueta">
                            <div id="${slotId}" class="qr-code"></div>
                        <div class="texto">
                            <strong>${maquina}</strong>
                            <span class="slot-label">${slotTexto}</span>
                        </div>
                        </div>
                    `);

                    // Gera o QR Code
                    try {
                        new QRCode(document.getElementById(slotId), {
                            text: labelData,
                            width: 64, // Aumentei um pouco para ter resolução
                            height: 64,
                            correctLevel: QRCode.CorrectLevel.M
                        });
                    } catch (err) {
                        console.error("Erro ao gerar QR Code para " + slotId, err);
                    }
                }
            }
    </script>
}