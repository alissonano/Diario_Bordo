@{
    ViewData["Title"] = "PDA Assembleon";
    var linha = ViewBag.Linha;
    var programa = ViewBag.Programa;
}

<style>
    :root {
        --pda-blue: #1a56db;
        --pda-blue-dark: #1e429f;
        --pda-surface: #f8fafc;
        --pda-border: #e2e8f0;
        --pda-text: #1e293b;
        --pda-muted: #64748b;
        --pda-success: #059669;
        --pda-success-bg: #ecfdf5;
        --pda-danger: #dc2626;
        --pda-danger-bg: #fef2f2;
        --pda-warning-bg: #fffbeb;
        --pda-warning: #d97706;
        --tap-min: 48px;
    }

    * {
        box-sizing: border-box;
        -webkit-tap-highlight-color: transparent;
    }

    body {
        font-family: -apple-system, 'SF Pro Text', system-ui, sans-serif;
        background: var(--pda-surface);
        overscroll-behavior: none;
    }

    /* ── Header ─────────────────────────────────────────── */
    .pda-header {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 16px 10px;
        background: #fff;
        border-bottom: 1px solid var(--pda-border);
        position: sticky;
        top: 0;
        z-index: 10;
    }

    .pda-back {
        display: flex;
        align-items: center;
        justify-content: center;
        width: var(--tap-min);
        height: var(--tap-min);
        border-radius: 12px;
        border: 1px solid var(--pda-border);
        background: #fff;
        color: var(--pda-text);
        text-decoration: none;
        flex-shrink: 0;
    }

        .pda-back svg {
            width: 20px;
            height: 20px;
            stroke: currentColor;
        }

    .pda-title-block {
        flex: 1;
        min-width: 0;
    }

        .pda-title-block .label {
            font-size: 11px;
            font-weight: 500;
            color: var(--pda-muted);
            text-transform: uppercase;
            letter-spacing: 0.06em;
        }

        .pda-title-block .value {
            font-size: 15px;
            font-weight: 600;
            color: var(--pda-text);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

            .pda-title-block .value span {
                color: var(--pda-blue);
            }

    /* ── Scan Area ───────────────────────────────────────── */
    .scan-area {
        padding: 14px 16px 8px;
        background: #fff;
        border-bottom: 1px solid var(--pda-border);
    }

    .scan-field {
        display: flex;
        align-items: center;
        gap: 10px;
        background: var(--pda-surface);
        border: 1.5px solid var(--pda-border);
        border-radius: 14px;
        padding: 0 14px;
        height: var(--tap-min);
        transition: border-color 0.15s;
    }

        .scan-field:focus-within {
            border-color: var(--pda-blue);
            background: #fff;
            box-shadow: 0 0 0 3px rgba(26,86,219,0.08);
        }

        .scan-field svg {
            width: 18px;
            height: 18px;
            stroke: var(--pda-muted);
            flex-shrink: 0;
        }

        .scan-field input {
            flex: 1;
            border: none;
            background: transparent;
            font-size: 16px; /* 16px evita zoom automático no iOS */
            color: var(--pda-text);
            outline: none;
            min-width: 0;
        }

            .scan-field input::placeholder {
                color: #94a3b8;
            }

            .scan-field input:disabled {
                opacity: 0.45;
                cursor: not-allowed;
            }

    .scan-badge {
        font-size: 10px;
        font-weight: 600;
        padding: 2px 7px;
        border-radius: 20px;
        background: var(--pda-blue);
        color: #fff;
        flex-shrink: 0;
    }

        .scan-badge.inactive {
            background: var(--pda-border);
            color: var(--pda-muted);
        }

    /* ── Feedback ────────────────────────────────────────── */
    #divFeedback {
        margin: 10px 16px 0;
        padding: 12px 16px;
        border-radius: 12px;
        display: none;
        animation: slideIn 0.2s ease;
    }

        #divFeedback.show {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        #divFeedback svg {
            width: 20px;
            height: 20px;
            flex-shrink: 0;
        }

    @@keyframes slideIn {
        from

    {
        opacity: 0;
        transform: translateY(-6px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    /* ── Tabela ──────────────────────────────────────────── */
    .table-wrapper {
        margin: 12px 16px 24px;
        border-radius: 14px;
        border: 1px solid var(--pda-border);
        overflow: hidden;
        background: #fff;
    }

    #tblSetup {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }

        #tblSetup thead th {
            background: var(--pda-text);
            color: #fff;
            font-weight: 600;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            padding: 10px 12px;
            text-align: left;
        }

            #tblSetup thead th:last-child {
                padding-right: 16px;
            }

        #tblSetup tbody tr {
            border-top: 1px solid var(--pda-border);
            transition: background 0.1s;
        }

            #tblSetup tbody tr:first-child {
                border-top: none;
            }

            #tblSetup tbody tr:active {
                background: var(--pda-surface);
            }

        #tblSetup td {
            padding: 10px 12px;
            color: var(--pda-text);
            vertical-align: middle;
        }

            #tblSetup td:first-child {
                font-size: 11px;
                font-weight: 600;
                color: var(--pda-muted);
                white-space: nowrap;
            }

            #tblSetup td:nth-child(2) {
                font-weight: 700;
                color: var(--pda-blue);
                font-size: 15px;
                width: 52px;
            }

            #tblSetup td:last-child {
                font-family: 'SF Mono', ui-monospace, monospace;
                font-size: 12px;
                color: var(--pda-text);
                word-break: break-all;
            }

    /* DataTables overrides */
    .dataTables_wrapper {
        padding: 0;
    }

    /* ── Modal ───────────────────────────────────────────── */
    .modal-content {
        border: none;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 25px 60px rgba(0,0,0,0.2);
    }

    .modal-header-pda {
        background: var(--pda-warning-bg);
        border-bottom: 1px solid #fde68a;
        padding: 18px 20px 14px;
    }

        .modal-header-pda .modal-label {
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.07em;
            color: var(--pda-warning);
            margin-bottom: 2px;
        }

        .modal-header-pda .modal-slot {
            font-size: 22px;
            font-weight: 700;
            color: var(--pda-text);
        }

    .modal-body-pda {
        padding: 20px;
    }

    .pn-label {
        font-size: 12px;
        color: var(--pda-muted);
        font-weight: 500;
        margin-bottom: 6px;
    }

    .pn-value {
        font-family: 'SF Mono', ui-monospace, monospace;
        font-size: 20px;
        font-weight: 700;
        color: var(--pda-blue-dark);
        word-break: break-all;
        margin-bottom: 20px;
        padding: 12px 14px;
        background: #eff6ff;
        border-radius: 10px;
        border: 1px solid #bfdbfe;
    }

    .scan-field-modal {
        background: var(--pda-surface);
        border: 2px solid var(--pda-border);
        border-radius: 14px;
        padding: 0 14px;
        height: 52px;
        display: flex;
        align-items: center;
        gap: 10px;
        transition: border-color 0.15s;
    }

        .scan-field-modal:focus-within {
            border-color: var(--pda-blue);
            background: #fff;
            box-shadow: 0 0 0 3px rgba(26,86,219,0.1);
        }

        .scan-field-modal svg {
            width: 20px;
            height: 20px;
            stroke: var(--pda-blue);
            flex-shrink: 0;
        }

        .scan-field-modal input {
            flex: 1;
            border: none;
            background: transparent;
            font-size: 16px;
            color: var(--pda-text);
            outline: none;
            font-weight: 500;
        }

            .scan-field-modal input::placeholder {
                color: #94a3b8;
                font-weight: 400;
            }

    /* Safe area para iPhone */
    .bottom-safe {
        padding-bottom: env(safe-area-inset-bottom, 16px);
    }

    /* Animação para o erro */
    .shake {
        animation: shake 0.5s cubic-bezier(.36,.07,.19,.97) both;
    }

    @@keyframes shake {
        10%, 90%

    {
        transform: translate3d(-1px, 0, 0);
    }

    20%, 80% {
        transform: translate3d(2px, 0, 0);
    }

    30%, 50%, 70% {
        transform: translate3d(-4px, 0, 0);
    }

    40%, 60% {
        transform: translate3d(4px, 0, 0);
    }

    }

    .modal-header-error {
        background: var(--pda-danger) !important;
        color: white !important;
    }

    .pda-logo {
        height: 32px; /* Ajuste conforme a altura do seu logo */
        width: auto; /* Mantém a proporção */
        object-fit: contain; /* Garante que não distorça */
        margin-right: 5px; /* Pequeno espaçamento para o título */
    }

    .pda-action {
        display: flex;
        align-items: center;
        justify-content: center;
        width: var(--tap-min);
        height: var(--tap-min);
        border-radius: 12px;
        border: 1px solid var(--pda-border);
        background: var(--pda-success-bg); /* Cor de fundo leve para destacar */
        color: var(--pda-success); /* Cor verde de "Auditoria/Check" */
        text-decoration: none;
        flex-shrink: 0;
        margin-left: 5px;
    }

        .pda-action svg {
            width: 24px;
            height: 24px;
        }

        .pda-action:active {
            background: var(--pda-success);
            color: #fff;
        }
</style>

<div>
    <!-- Header sticky -->
    <div class="pda-header">
        <a href="@Url.Action("FeederCheck", "Setup")" class="pda-back" aria-label="Voltar">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
        </a>

        <div class="pda-title-block">
            <div class="label">PDA Assembleon</div>
            <div class="value">@linha &nbsp;|&nbsp; <span>@programa</span></div>
        </div>

        <a href="@Url.Action("PDAAudit", "Setup", new { linha = linha, programa = programa })"
           class="pda-action" title="Ir para Auditoria">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 11l3 3L22 4"></path>
                <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
            </svg>
        </a>
    </div>

    <!-- Inputs de scan -->
    <div class="scan-area">
        <div class="scan-field">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" />
                <line x1="3" y1="9" x2="21" y2="9" />
                <line x1="3" y1="15" x2="21" y2="15" />
                <line x1="9" y1="9" x2="9" y2="21" />
                <line x1="15" y1="9" x2="15" y2="21" />
            </svg>
            <input type="text" id="inputSlot" placeholder="Bipe o Slot..." autocomplete="off" inputmode="none">
            <span class="scan-badge" id="badgeSlot">SLOT</span>
        </div>
    </div>

    <!-- Feedback -->
    <div id="divFeedback">
        <svg id="iconFeedback" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></svg>
        <span id="txtFeedback" style="font-size:14px; font-weight:600;"></span>
    </div>

    <!-- Tabela -->
    <div class="table-wrapper bottom-safe">
        <table id="tblSetup" style="width:100%">
            <thead>
                <tr>
                    <th>Máquina</th>
                    <th>Slot</th>
                    <th>Part Number</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="modalScanRolo" data-bs-backdrop="static" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered" style="margin: 16px; max-width: calc(100% - 32px);">
        <div class="modal-content">
            <div class="modal-header-pda" id="modalHeader">
                <div class="modal-label">Validação de Slot</div>
                <div class="modal-slot">Slot <span id="spanSlot" style="color:var(--pda-blue);">—</span></div>
            </div>
            <div class="modal-body-pda">
                <div id="errorContainer" class="alert alert-danger d-none mb-3 p-2 text-center fw-bold">
                    <span id="errorText"></span>
                </div>

                <div class="pn-label">Componente Esperado</div>
                <div class="pn-value" id="spanPN">—</div>

                <div class="scan-field-modal">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
                    </svg>
                    <input type="text" id="inputRoloModal" placeholder="Bipe o Rolo aqui..." autocomplete="off" inputmode="none">
                </div>
            </div>
            <div class="modal-footer border-0 p-3 pt-0">
                <button type="button" class="btn btn-secondary w-100 py-3 fw-bold" id="btnCloseModal" data-bs-dismiss="modal">CANCELAR</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let linhaAtual = '@linha';
        let programaAtual = '@programa';
        let maquinaAtual = ""; // <--- Adicione esta variável global
        let table;



        $(document).ready(function () {
            table = $('#tblSetup').DataTable({
                ajax: {
                    url: '@Url.Action("GetDetalhesSetup", "Setup")',
                    data: { linha: linhaAtual, programa: programaAtual },
                    dataSrc: ""
                },
                columns: [
                    { data: 'maquina' },
                    { data: 'slot' },
                    { data: 'partnumber' }
                ],
                paging: false,
                searching: false,
                info: false,
                ordering: false
            });

            $('#inputSlot').focus();
        });

        // Ao ler o SLOT na tela principal
        $('#inputSlot').on('keypress', function (e) {
            if (e.which === 13) {
                let valor = $(this).val().trim();
                let partes = valor.split(/[;/]/);

                if (partes.length === 2) {
                    let maquinaLida = partes[0].trim();
                    let slotLido = partes[1].trim();

                    maquinaAtual = maquinaLida;

                    let rowData = table.rows().data().toArray().find(r =>
                        r.maquina == maquinaLida && r.slot == slotLido
                    );

                    if (rowData) {
                        $('#spanSlot').text(slotLido);
                        $('#spanPN').text(rowData.partnumber);
                        $('#modalScanRolo').modal('show');
                        $('#inputSlot').val('');
                        setTimeout(() => { $('#inputRoloModal').focus(); }, 500);
                       
                    } else {
                        mostrarFeedback('Máquina ou Slot não encontrado no setup atual.', 'erro');
                        $(this).val('').focus();
                    }
                } else {
                    mostrarFeedback('Formato inválido. Esperado: Máquina ; Slot', 'erro');
                    $(this).val('').focus();
                }
            }
        });

        // Ao ler o ROLO dentro do Modal
                $('#inputRoloModal').on('keypress', function (e) {
            if (e.which === 13) {
                let valor = $(this).val().trim();
                console.log("String lida do rolo:", valor); // Adicione isso para debugar no F12

                // Ajuste: buscando pelo 'ç' que você enviou
                let partes = valor.split(/[ç;]/);

                if (partes.length >= 2) {

                    validarNoServidor({
                        linha: linhaAtual,
                        programa: programaAtual,
                        maquina: maquinaAtual,
                        slot: $('#spanSlot').text(),
                        codigoUnico: partes[0].trim(),
                        partnumber: partes[1].trim()
                    });
                } else {
                    // Agora, se o split falhar, o sistema te avisa o erro!
                    alert("Erro: Formato do rolo não reconhecido. Valor lido: " + valor);
                    $(this).val('').focus();
                }
            }
        });

        function validarNoServidor(payload) {
            $.ajax({
                url: '@Url.Action("ValidarFeeder", "Setup")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    if (res.success) {
                        playSound('success');
                        $('#modalScanRolo').modal('hide'); // Fecha apenas no SUCESSO
                        mostrarFeedback(res.mensagem, 'ok');
                        $('#inputSlot').val('').focus();
                        $('#inputRoloModal').val('');
                    } else {
                        handleErro(res.mensagem); // Mantém aberto e mostra erro
                    }
                },
                error: function () {
                    playSound('error');
                    handleErro('Erro de comunicação com servidor!');
                }
            });
        }

                // 1. Ao fechar o modal, limpa os erros para a próxima vez
        $('#modalScanRolo').on('hidden.bs.modal', function () {
            $('#errorContainer').addClass('d-none');
            $('#modalHeader').removeClass('modal-header-error');
            $('.modal-content').removeClass('shake');
            $('#inputRoloModal').val('');
                setTimeout(function() {
            $('#inputSlot').focus();
        }, 100);
        });

        // 2. Função HandleErro melhorada
        function handleErro(msg) {
            const modalContent = $('.modal-content');
            const header = $('#modalHeader');
            const errContainer = $('#errorContainer');
            const errText = $('#errorText');

            // Exibe o erro dentro do modal
            errText.text(msg);
            errContainer.removeClass('d-none');

            // Efeito visual
            header.addClass('modal-header-error');
            modalContent.addClass('shake');

            // Foca no input para permitir nova tentativa imediatamente após ler o erro
            $('#inputRoloModal').val('').focus();

            // Remove o shake após a animação
            setTimeout(() => {
                modalContent.removeClass('shake');
            }, 1000);
        }

        function mostrarFeedback(msg, tipo) {
            const div = $('#divFeedback');
            const txt = $('#txtFeedback');
            const icon = $('#iconFeedback');

            div.removeClass('show').css({ background: '', color: '' });

            if (tipo === 'ok') {
                div.css({ background: 'var(--pda-success-bg)', color: 'var(--pda-success)' });
                icon.html('<polyline points="20 6 9 17 4 12" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>');
            } else {
                div.css({ background: 'var(--pda-danger-bg)', color: 'var(--pda-danger)' });
                icon.html('<line x1="18" y1="6" x2="6" y2="18" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><line x1="6" y1="6" x2="18" y2="18" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>');
            }

            txt.text(msg);
            div.addClass('show');

            setTimeout(() => {
                div.removeClass('show').css({ display: 'none' });
            }, 3500);
        }



                // Sons em Base64 (Leves e instantâneos)
        const beepSuccess = new Audio("data:audio/wav;base64,UklGRigAAABXQVZFZm10IBAAAAABAAEAQB8AAEAfAAABAAgAZGF0YQAAAAA="); // Placeholder
        // Para sons reais e curtos, usaremos uma função que gera o tom via Web Audio API (Melhor performance)
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

        function playSound(type) {
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();

            osc.connect(gain);
            gain.connect(audioCtx.destination);

            if (type === 'success') {
                osc.frequency.value = 880; // Tom alto
                gain.gain.value = 0.2;
                osc.start();
                osc.stop(audioCtx.currentTime + 0.1); // Beep curto
            } else {
                osc.frequency.value = 220; // Tom baixo
                gain.gain.value = 0.3;
                osc.type = 'sawtooth'; // Som mais "buzzer"
                osc.start();
                osc.stop(audioCtx.currentTime + 0.3); // Buzz um pouco mais longo
            }
        }
    </script>
}
