@{
    ViewData["Title"] = "Auditoria de Setup";
    var linha = ViewBag.Linha;
    var programa = ViewBag.Programa;
}

<style>
    :root {
        --pda-blue: #1a56db;
        --pda-blue-dark: #1e429f;
        --pda-surface: #f8fafc;
        --pda-border: #e2e8f0;
        --pda-text: #1e293b;
        --pda-muted: #64748b;
        --pda-success: #059669;
        --pda-success-bg: #ecfdf5;
        --pda-danger: #dc2626;
        --pda-danger-bg: #fef2f2;
        --pda-warning-bg: #fffbeb;
        --pda-warning: #d97706;
        --tap-min: 48px;
    }

    * {
        box-sizing: border-box;
        -webkit-tap-highlight-color: transparent;
    }

    body {
        font-family: -apple-system, 'SF Pro Text', system-ui, sans-serif;
        background: var(--pda-surface);
        overscroll-behavior: none;
    }

    /* ── Header ─────────────────────────────────────────── */
    .pda-header {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 16px 10px;
        background: #fff;
        border-bottom: 1px solid var(--pda-border);
        position: sticky;
        top: 0;
        z-index: 10;
    }

    .pda-back,
    .pda-action {
        display: flex;
        align-items: center;
        justify-content: center;
        width: var(--tap-min);
        height: var(--tap-min);
        border-radius: 12px;
        border: 1px solid var(--pda-border);
        background: #fff;
        color: var(--pda-text);
        text-decoration: none;
        flex-shrink: 0;
    }

        .pda-back svg,
        .pda-action svg {
            width: 22px;
            height: 22px;
            stroke: currentColor;
        }

    .pda-action {
        background: var(--pda-success-bg);
        color: var(--pda-success);
        margin-left: 5px;
    }

        .pda-action:active {
            background: var(--pda-success);
            color: #fff;
        }

    .pda-title-block {
        flex: 1;
        min-width: 0;
    }

        .pda-title-block .label {
            font-size: 11px;
            font-weight: 500;
            color: var(--pda-muted);
            text-transform: uppercase;
            letter-spacing: 0.06em;
        }

        .pda-title-block .value {
            font-size: 15px;
            font-weight: 600;
            color: var(--pda-text);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

            .pda-title-block .value span {
                color: var(--pda-blue);
            }

    /* ── Painel de auditoria ────────────────────────────── */
    .audit-summary {
        padding: 14px 16px 8px;
        background: #fff;
        border-bottom: 1px solid var(--pda-border);
    }

    .progress-card {
        background: var(--pda-surface);
        border: 1px solid var(--pda-border);
        border-radius: 14px;
        padding: 12px 14px;
    }

    .progress-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 8px;
    }

    .progress-label {
        font-size: 11px;
        font-weight: 600;
        color: var(--pda-muted);
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    .progress-percent {
        font-size: 12px;
        font-weight: 700;
        color: var(--pda-success);
    }

    .progress-track {
        width: 100%;
        height: 10px;
        background: #e5e7eb;
        border-radius: 999px;
        overflow: hidden;
    }

    #progressBar {
        height: 100%;
        width: 0%;
        border-radius: 999px;
        background: var(--pda-success);
        transition: width 0.25s ease;
    }

    .target-card {
        margin: 12px 16px 0;
        padding: 16px;
        background: #fff;
        border: 1px solid var(--pda-border);
        border-radius: 16px;
        box-shadow: 0 8px 22px rgba(15, 23, 42, 0.04);
    }

        .target-card.complete {
            background: var(--pda-success-bg);
            border-color: rgba(5, 150, 105, 0.25);
        }

    .target-label {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        margin-bottom: 8px;
        font-size: 11px;
        font-weight: 600;
        color: var(--pda-muted);
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    .target-seq {
        color: var(--pda-blue);
        white-space: nowrap;
    }

    #spanTargetSlot {
        font-size: 15px;
        font-weight: 700;
        color: var(--pda-text);
        margin-bottom: 8px;
    }

    #spanTargetPN {
        font-family: 'SF Mono', ui-monospace, monospace;
        font-size: 22px;
        line-height: 1.2;
        font-weight: 800;
        color: var(--pda-blue-dark);
        word-break: break-all;
        padding: 12px 14px;
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        border-radius: 12px;
    }

    .target-card.complete #spanTargetPN {
        color: var(--pda-success);
        background: #fff;
        border-color: rgba(5, 150, 105, 0.25);
    }

    /* ── Scan Area ───────────────────────────────────────── */
    .scan-area {
        padding: 14px 16px 8px;
    }

    .scan-field {
        display: flex;
        align-items: center;
        gap: 10px;
        background: var(--pda-surface);
        border: 1.5px solid var(--pda-border);
        border-radius: 14px;
        padding: 0 14px;
        height: var(--tap-min);
        transition: border-color 0.15s;
    }

        .scan-field:focus-within {
            border-color: var(--pda-blue);
            background: #fff;
            box-shadow: 0 0 0 3px rgba(26,86,219,0.08);
        }

        .scan-field svg {
            width: 18px;
            height: 18px;
            stroke: var(--pda-muted);
            flex-shrink: 0;
        }

        .scan-field input {
            flex: 1;
            border: none;
            background: transparent;
            font-size: 16px; /* 16px evita zoom automático no iOS */
            color: var(--pda-text);
            outline: none;
            min-width: 0;
        }

            .scan-field input::placeholder {
                color: #94a3b8;
            }

            .scan-field input:disabled {
                opacity: 0.45;
                cursor: not-allowed;
            }

    .scan-badge {
        font-size: 10px;
        font-weight: 600;
        padding: 2px 7px;
        border-radius: 20px;
        background: var(--pda-blue);
        color: #fff;
        flex-shrink: 0;
    }

        .scan-badge.inactive {
            background: var(--pda-border);
            color: var(--pda-muted);
        }

    /* ── Feedback ────────────────────────────────────────── */
    #divFeedback {
        margin: 10px 16px 0;
        padding: 12px 16px;
        border-radius: 12px;
        display: none;
        animation: slideIn 0.2s ease;
    }

        #divFeedback.show {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        #divFeedback svg {
            width: 20px;
            height: 20px;
            flex-shrink: 0;
        }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(-6px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ── Tabela ──────────────────────────────────────────── */
    .table-wrapper {
        margin: 12px 16px 24px;
        border-radius: 14px;
        border: 1px solid var(--pda-border);
        overflow: hidden;
        background: #fff;
    }

    #tblSetup {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }

        #tblSetup thead th {
            background: var(--pda-text);
            color: #fff;
            font-weight: 600;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            padding: 10px 12px;
            text-align: left;
        }

            #tblSetup thead th:last-child {
                text-align: center;
                padding-right: 16px;
            }

        #tblSetup tbody tr {
            border-top: 1px solid var(--pda-border);
            transition: background 0.15s, box-shadow 0.15s;
        }

            #tblSetup tbody tr:first-child {
                border-top: none;
            }

            #tblSetup tbody tr:active {
                background: var(--pda-surface);
            }

        #tblSetup td {
            padding: 10px 12px;
            color: var(--pda-text);
            vertical-align: middle;
        }

            #tblSetup td:first-child {
                font-size: 11px;
                font-weight: 600;
                color: var(--pda-muted);
                white-space: nowrap;
            }

            #tblSetup td:nth-child(2) {
                font-weight: 700;
                color: var(--pda-blue);
                font-size: 15px;
                width: 52px;
            }

            #tblSetup td:nth-child(3) {
                font-family: 'SF Mono', ui-monospace, monospace;
                font-size: 12px;
                color: var(--pda-text);
                word-break: break-all;
            }

            #tblSetup td:last-child {
                text-align: center;
                width: 64px;
            }

    .dataTables_wrapper {
        padding: 0;
    }

    .status-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        border-radius: 999px;
    }

        .status-icon svg {
            width: 21px;
            height: 21px;
        }

    .status-pending {
        color: #cbd5e1;
    }

    .status-checked {
        color: var(--pda-success);
        background: var(--pda-success-bg);
    }

    .row-current {
        background: #eff6ff !important;
        box-shadow: inset 4px 0 0 var(--pda-blue);
    }

    .row-success {
        background-color: var(--pda-success-bg) !important;
        transition: background 0.3s;
    }

    .row-error {
        background-color: var(--pda-danger-bg) !important;
        transition: background 0.3s;
    }

    .bottom-safe {
        padding-bottom: env(safe-area-inset-bottom, 16px);
    }
</style>

<div>
    <!-- Header sticky -->
    <div class="pda-header">
        <a href="@Url.Action("FeederCheck", "Setup")" class="pda-back" aria-label="Voltar">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
        </a>

        <div class="pda-title-block">
            <div class="label">Auditoria de Setup</div>
            <div class="value">@linha &nbsp;|&nbsp; <span>@programa</span></div>
        </div>

        <a href="@Url.Action("PDAAssembleon", "Setup", new { linha = linha, programa = programa })"
           class="pda-action" title="Voltar para PDA Assembleon" aria-label="Voltar para PDA Assembleon">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                <line x1="3" y1="9" x2="21" y2="9"></line>
                <line x1="3" y1="15" x2="21" y2="15"></line>
                <line x1="9" y1="9" x2="9" y2="21"></line>
                <line x1="15" y1="9" x2="15" y2="21"></line>
            </svg>
        </a>
    </div>

    <!-- Progresso -->
    <div class="audit-summary">
        <div class="progress-card">
            <div class="progress-top">
                <div class="progress-label">Progresso da Auditoria</div>
                <div class="progress-percent" id="progressText">0%</div>
            </div>
            <div class="progress-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
                <div id="progressBar"></div>
            </div>
        </div>
    </div>

    <!-- Próximo item -->
    <div class="target-card" id="targetCard">
        <div class="target-label">
            <span>Próximo Feeder</span>
            <span class="target-seq">Seq: <span id="spanSeq">0</span></span>
        </div>
        <div id="spanTargetSlot">Aguardando início...</div>
        <div id="spanTargetPN">---</div>
    </div>

    <!-- Input de scan -->
    <div class="scan-area">
        <div class="scan-field">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
            </svg>
            <input type="text" id="inputAudit" placeholder="Bipe o feeder..." autocomplete="off" inputmode="none">
            <span class="scan-badge" id="badgeAudit">AUDIT</span>
        </div>
    </div>

    <!-- Feedback -->
    <div id="divFeedback">
        <svg id="iconFeedback" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></svg>
        <span id="txtFeedback" style="font-size:14px; font-weight:600;"></span>
    </div>

    <!-- Tabela -->
    <div class="table-wrapper bottom-safe">
        <table id="tblSetup" style="width:100%">
            <thead>
                <tr>
                    <th>Máquina</th>
                    <th>Slot</th>
                    <th>Part Number</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        let linhaAtual = '@linha';
        let programaAtual = '@programa';
        let setupList = [];
        let currentIndex = 0;
        let table;
        let audioCtx;

        $(document).ready(function () {
            table = $('#tblSetup').DataTable({
                ajax: {
                    url: '@Url.Action("GetDetalhesSetup", "Setup")',
                    data: { linha: linhaAtual, programa: programaAtual },
                    dataSrc: ""
                },
                columns: [
                    { data: 'maquina' },
                    { data: 'slot' },
                    { data: 'partnumber' },
                    {
                        data: null,
                        render: function (data, type, row, meta) {
                            return `
                                <div class="status-icon status-pending" id="status-${meta.row}">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="12" cy="12" r="9"></circle>
                                    </svg>
                                </div>`;
                        }
                    }
                ],
                paging: false,
                searching: false,
                info: false,
                ordering: false,
                initComplete: function (settings, json) {
                    setupList = json || [];
                    updateNextFeeder();
                }
            });

            $('#inputAudit').focus();
        });

        function updateNextFeeder() {
            $('#tblSetup tbody tr').removeClass('row-current');

            if (setupList.length === 0) {
                $('#spanTargetSlot').text('Nenhum feeder encontrado.');
                $('#spanTargetPN').text('---');
                $('#spanSeq').text('0 de 0');
                updateProgress(0);
                return;
            }

            if (currentIndex < setupList.length) {
                let item = setupList[currentIndex];
                let rowNode = table.row(currentIndex).node();

                $('#targetCard').removeClass('complete');
                $('#spanTargetSlot').text(`Máq: ${item.maquina} | Slot: ${item.slot}`);
                $('#spanTargetPN').text(item.partnumber);
                $('#spanSeq').text(`${currentIndex + 1} de ${setupList.length}`);

                $(rowNode).addClass('row-current');

                let percent = (currentIndex / setupList.length) * 100;
                updateProgress(percent);
            } else {
                $('#targetCard').addClass('complete');
                $('#spanTargetSlot').text('Auditoria Finalizada!');
                $('#spanTargetPN').text('✓ OK');
                $('#spanSeq').text(`${setupList.length} de ${setupList.length}`);
                $('#inputAudit').prop('disabled', true);
                $('#badgeAudit').addClass('inactive').text('OK');
                updateProgress(100);
            }
        }

        function updateProgress(percent) {
            let rounded = Math.round(percent);
            $('#progressBar').css('width', rounded + '%');
            $('#progressText').text(rounded + '%');
            $('.progress-track').attr('aria-valuenow', rounded);
        }

        $('#inputAudit').on('keypress', function (e) {
            if (e.which === 13) {
                let valor = $(this).val().trim();
                let partes = valor.split(/[ç;]/);

                if (partes.length >= 2 && currentIndex < setupList.length) {
                    let pnLido = partes[1].trim();
                    let esperado = setupList[currentIndex].partnumber;
                    let rowNode = table.row(currentIndex).node();

                    if (pnLido === esperado) {
                        $(rowNode).removeClass('row-current row-error').addClass('row-success');

                        $('#status-' + currentIndex).removeClass('status-pending').addClass('status-checked').html(`
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 12l2 2 4-4"></path>
                                <circle cx="12" cy="12" r="9"></circle>
                            </svg>`);

                        $('html, body').animate({ scrollTop: $(rowNode).offset().top - 150 }, 200);

                        playSound('success');
                        mostrarFeedback('Item ' + (currentIndex + 1) + ' validado!', 'ok');

                        currentIndex++;
                        updateNextFeeder();
                    } else {
                        $(rowNode).addClass('row-error');
                        playSound('error');
                        mostrarFeedback('ERRO: Esperado ' + esperado, 'erro');
                        setTimeout(() => $(rowNode).removeClass('row-error'), 1000);
                    }
                } else if (currentIndex >= setupList.length && setupList.length > 0) {
                    mostrarFeedback('Auditoria já finalizada.', 'ok');
                } else {
                    mostrarFeedback('Formato inválido.', 'erro');
                }

                $(this).val('').focus();
            }
        });

        function playSound(type) {
            try {
                if (!audioCtx) {
                    audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                }

                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();

                osc.connect(gain);
                gain.connect(audioCtx.destination);

                if (type === 'success') {
                    osc.frequency.value = 880;
                    gain.gain.value = 0.2;
                    osc.start();
                    osc.stop(audioCtx.currentTime + 0.1);
                } else {
                    osc.frequency.value = 220;
                    gain.gain.value = 0.3;
                    osc.type = 'sawtooth';
                    osc.start();
                    osc.stop(audioCtx.currentTime + 0.3);
                }
            } catch (e) {
                console.warn('Não foi possível executar o áudio:', e);
            }
        }

        function mostrarFeedback(msg, tipo) {
            const div = $('#divFeedback');
            const txt = $('#txtFeedback');
            const icon = $('#iconFeedback');

            div.removeClass('show').css({ background: '', color: '' });

            if (tipo === 'ok') {
                div.css({ background: 'var(--pda-success-bg)', color: 'var(--pda-success)' });
                icon.html('<polyline points="20 6 9 17 4 12" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>');
            } else {
                div.css({ background: 'var(--pda-danger-bg)', color: 'var(--pda-danger)' });
                icon.html('<line x1="18" y1="6" x2="6" y2="18" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><line x1="6" y1="6" x2="18" y2="18" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>');
            }

            txt.text(msg);
            div.addClass('show');

            setTimeout(() => {
                div.removeClass('show').css({ display: 'none' });
            }, 3000);
        }
    </script>
}
