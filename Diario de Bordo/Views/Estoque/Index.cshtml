@model Diario_de_Bordo.Models.EstoqueViewModel

@{
    ViewData["Title"] = "Painel de Controle SMT";
}

<div class="container-fluid py-3 px-3">
    @* Cabeçalho Adaptável *@
    <div class="row align-items-center mb-4 g-3">
        <div class="col-12 col-md-6">
            <h3 class="fw-bold mb-0 text-dark">
                <i class="bi bi-speedometer2 text-primary me-2"></i>HUB SMT
            </h3>
            <p class="text-muted mb-0 small text-uppercase fw-semibold" style="letter-spacing: 1px;">Monitoramento em Tempo Real</p>
        </div>
        <div class="col-12 col-md-6 d-flex justify-content-md-end gap-2">
            @* Widget Itens Zerados - Compacto no Mobile *@
            <div class="card bg-white shadow-sm border-0 px-3 py-2 flex-grow-1 flex-md-grow-0 d-flex flex-row align-items-center">
                <i class="bi bi-exclamation-octagon text-danger me-2 fs-5"></i>
                <div>
                    <small class="text-muted d-block" style="font-size: 0.6rem;">ZERADOS</small>
                    <span class="fw-bold text-danger">@Model.Itens.Count(i => i.QuantidadeAtual <= 0)</span>
                </div>
            </div>
            <div class="card bg-white shadow-sm border-0 px-3 py-2 d-none d-sm-flex flex-row align-items-center">
                <div class="spinner-grow spinner-grow-sm text-success me-2" role="status"></div>
                <span class="text-dark fw-bold small">ONLINE</span>
            </div>
        </div>
    </div>

    @* Menu de Acesso Rápido - 2 por linha no Mobile *@
    <div class="row g-2 mb-4">
        <div class="col-6 col-md-3">
            <a asp-action="ListagemGeral" class="card h-100 border-0 shadow-sm text-decoration-none p-3 bg-white border-bottom border-primary border-4 hover-shadow">
                <div class="text-center text-md-start">
                    <i class="bi bi-box-seam fs-3 text-primary d-block d-md-none mb-2"></i>
                    <h6 class="mb-0 fw-bold text-dark">Estoque</h6>
                    <small class="text-muted d-none d-md-block">Geral</small>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-action="Requisicoes" class="card h-100 border-0 shadow-sm text-decoration-none p-3 bg-white border-bottom border-warning border-4 hover-shadow">
                <div class="text-center text-md-start">
                    <i class="bi bi-clipboard-data fs-3 text-warning d-block d-md-none mb-2"></i>
                    <h6 class="mb-0 fw-bold text-dark">Requisições</h6>
                    <span class="badge bg-warning text-dark mt-1">@Model.SolicitacoesPendentes.Count()</span>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-action="CadastrarItem" class="card h-100 border-0 shadow-sm text-decoration-none p-3 bg-white border-bottom border-success border-4 hover-shadow">
                <div class="text-center text-md-start">
                    <i class="bi bi-plus-circle fs-3 text-success d-block d-md-none mb-2"></i>
                    <h6 class="mb-0 fw-bold text-dark">Cadastrar</h6>
                    <small class="text-muted d-none d-md-block">Novo Item</small>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-controller="Fornecedores" asp-action="Index" class="card h-100 border-0 shadow-sm text-decoration-none p-3 bg-white border-bottom border-info border-4 hover-shadow">
                <div class="text-center text-md-start">
                    <i class="bi bi-truck fs-3 text-info d-block d-md-none mb-2"></i>
                    <h6 class="mb-0 fw-bold text-dark">Parceiros</h6>
                    <small class="text-muted d-none d-md-block">Fornecedores</small>
                </div>
            </a>
        </div>
    </div>

    @* FILA DE ATENDIMENTO *@
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3 border-0">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark small-mobile-title">
                    <i class="bi bi-list-stars me-1 text-primary"></i>Fila de Atendimento
                </h5>
                <a asp-action="Requisicoes" class="btn btn-primary btn-sm rounded-pill px-3 fw-bold">
                    VER TODAS
                </a>
            </div>
        </div>

        @* Versão Desktop: Tabela *@
        <div class="table-responsive d-none d-md-block">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">HORA</th>
                        <th>TÉCNICO</th>
                        <th>ITEM / DESCRIÇÃO</th>
                        <th class="text-center">PEDIDO</th>
                        <th class="text-center">SALDO</th>
                        <th class="pe-4">STATUS</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.SolicitacoesPendentes.Take(8))
                    {
                        var semEstoque = p.ItemEstoqueId != null && p.ItemEstoque?.QuantidadeAtual < p.Quantidade;
                        <tr>
                            <td class="ps-4">
                                <span class="fw-bold">@p.DataSolicitacao.ToString("HH:mm")</span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="avatar-sm bg-primary-subtle text-primary me-2">@p.TecnicoResponsavel.Substring(0, 1)</div>
                                    <span class="small fw-semibold">@p.TecnicoResponsavel</span>
                                </div>
                            </td>
                            <td>
                                <div class="fw-bold text-primary small">@(p.ItemEstoque?.PartNumber ?? "AVULSO")</div>
                                <div class="text-muted" style="font-size: 0.75rem;">@(p.ItemEstoque?.Descricao ?? p.DescricaoAvulsa)</div>
                            </td>
                            <td class="text-center fw-bold">@p.Quantidade</td>
                            <td class="text-center fw-bold @(semEstoque ? "text-danger" : "text-success")">
                                @(p.ItemEstoque?.QuantidadeAtual.ToString() ?? "-")
                            </td>
                            <td class="pe-4">
                                @if (semEstoque)
                                {
                                    <span class="badge bg-danger">SEM SALDO</span>
                                }
                                else
                                {

                                    <span class="badge bg-success">OK</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Versão Mobile: Cards *@
        <div class="d-md-none border-top">
            @foreach (var p in Model.SolicitacoesPendentes.Take(8))
            {
                var semEstoque = p.ItemEstoqueId != null && p.ItemEstoque?.QuantidadeAtual < p.Quantidade;
                <div class="p-3 border-bottom position-relative">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="badge bg-light text-dark shadow-sm">@p.DataSolicitacao.ToString("HH:mm")</span>
                        @if (semEstoque)
                        {
                            <span class="text-danger fw-bold small"><i class="bi bi-x-circle-fill me-1"></i>CRÍTICO</span>
                        }
                        else
                        {

                            <span class="text-success fw-bold small"><i class="bi bi-check-circle-fill me-1"></i>DISPONÍVEL</span>
                        }
                    </div>

                    <div class="fw-bold text-primary mb-1">@(p.ItemEstoque?.PartNumber ?? "ITEM AVULSO")</div>
                    <div class="text-muted small mb-2 text-truncate">@(p.ItemEstoque?.Descricao ?? p.DescricaoAvulsa)</div>

                    <div class="d-flex justify-content-between align-items-center bg-light rounded p-2">
                        <div class="small text-secondary">Solicitado: <strong>@p.Quantidade</strong></div>
                        <div class="small text-secondary">Saldo: <strong class="@(semEstoque ? "text-danger" : "text-success")">@(p.ItemEstoque?.QuantidadeAtual.ToString() ?? "-")</strong></div>
                        <div class="small fw-bold text-dark"><i class="bi bi-person me-1"></i>@p.TecnicoResponsavel</div>
                    </div>
                </div>
            }
        </div>

        @if (!Model.SolicitacoesPendentes.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-check2-all display-4 text-success opacity-25"></i>
                <p class="text-muted mt-2 fw-bold">Tudo em dia!</p>
            </div>
        }
    </div>
</div>

<style>
    body {
        background-color: #f4f7f6;
    }

    .hover-shadow:hover {
        transform: translateY(-2px);
        box-shadow: 0 .4rem 1rem rgba(0,0,0,.1) !important;
        transition: 0.2s;
    }

    .avatar-sm {
        width: 26px;
        height: 26px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        font-size: 0.7rem;
        font-weight: bold;
    }

    .table thead th {
        font-size: 0.65rem;
        letter-spacing: 1px;
        color: #8898aa;
        padding: 12px 10px;
        text-transform: uppercase;
        border: none;
    }

    /* Ajuste para títulos longos em celulares pequenos */
    @@media (max-width: 380px) {
        .small-mobile-title {
            font-size: 0.9rem;
        }
    }
</style>