@model Diario_de_Bordo.Models.Estoque.ItemEstoque

@{
    ViewData["Title"] = "Editar Item";
}

@* 1. Biblioteca de Geração Local de QR Code *@
<script src="~/lib/qrcodejs/qrcode.min.js"></script>

<div class="container-fluid px-2 py-4">
    @* Cabeçalho de Edição *@
    <div class="d-flex align-items-center justify-content-between mb-5 border-bottom pb-4 px-3">
        <div class="d-flex align-items-center">
            <a asp-action="ListagemGeral" class="btn btn-outline-secondary btn-sm rounded-circle me-4" title="Voltar">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div>
                <h2 class="fw-bold text-dark m-0">Editar Registro</h2>
                <p class="text-muted m-0 fs-5 fw-light">@Model.PartNumber — @Model.Descricao</p>
            </div>
        </div>

        <form asp-action="Excluir" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('ATENÇÃO: Deseja excluir permanentemente este item?');">
            <button type="submit" class="btn btn-link text-danger text-decoration-none small fw-bold p-0">
                <i class="bi bi-trash3 me-1"></i> EXCLUIR ITEM
            </button>
        </form>
    </div>

    <form asp-action="Editar" method="post" enctype="multipart/form-data" class="px-3">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="FotoPath" />
        @Html.AntiForgeryToken()

        <div class="row g-5">
            @* Coluna da Esquerda - Dados *@
            <div class="col-md-9">
                <div class="row g-4">
                    @* Campo EAN - Readonly *@
                    <div class="col-md-4">
                        <label asp-for="codigoean" class="form-label small fw-bold text-muted text-uppercase">Código EAN / Barcode</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0 border-bottom rounded-0"><i class="bi bi-lock-fill text-muted"></i></span>
                            <input asp-for="codigoean" class="form-control border-0 border-bottom rounded-0 px-0 shadow-none bg-light fw-bold text-muted"
                                   readonly style="cursor: not-allowed;" />
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="PartNumber" class="form-label small fw-bold text-secondary text-uppercase">Part Number</label>
                        <input asp-for="PartNumber" id="inputPN" class="form-control border-0 border-bottom rounded-0 px-0 shadow-none bg-transparent fw-bold" required />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Descricao" class="form-label small fw-bold text-secondary text-uppercase">Descrição do Material</label>
                        <input asp-for="Descricao" id="inputDesc" class="form-control border-0 border-bottom rounded-0 px-0 shadow-none bg-transparent" required />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Tipo" class="form-label small fw-bold text-secondary text-uppercase">Tipo de Item</label>
                        <select asp-for="Tipo" class="form-select border-0 border-bottom rounded-0 px-0 shadow-none bg-transparent"
                                asp-items="Html.GetEnumSelectList<Diario_de_Bordo.Models.Estoque.TipoEquipamento>()">
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="FabricanteEquipamento" class="form-label small fw-bold text-secondary text-uppercase">Equipamento (Máquina)</label>
                        <input asp-for="FabricanteEquipamento" class="form-control border-0 border-bottom rounded-0 px-0 shadow-none bg-transparent" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="FornecedorId" class="form-label small fw-bold text-secondary text-uppercase">Fornecedor</label>
                        <select asp-for="FornecedorId" class="form-select border-0 border-bottom rounded-0 px-0 shadow-none bg-transparent"
                                asp-items="ViewBag.Fornecedores">
                            <option value="">Selecione...</option>
                        </select>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="Localizacao" class="form-label small fw-bold text-secondary text-uppercase">Localização no Almoxarifado</label>
                        <input asp-for="Localizacao" id="inputLoc" class="form-control border-0 border-bottom rounded-0 px-0 shadow-none bg-transparent" />
                    </div>

                    <div class="col-md-3">
                        <label asp-for="QuantidadeAtual" class="form-label small fw-bold text-secondary text-uppercase">Qtd Atual</label>
                        <input asp-for="QuantidadeAtual" type="number" step="0.01" class="form-control border-0 border-bottom rounded-0 px-0 shadow-none bg-transparent fw-bold text-primary" />
                    </div>

                    <div class="col-md-3">
                        <label asp-for="EstoqueMinimo" class="form-label small fw-bold text-secondary text-uppercase">Qtd Mínima</label>
                        <input asp-for="EstoqueMinimo" type="number" step="0.01" class="form-control border-0 border-bottom rounded-0 px-0 shadow-none bg-transparent text-danger fw-bold" />
                    </div>

                    <div class="col-md-3">
                        <label asp-for="Unidade" class="form-label small fw-bold text-secondary text-uppercase">Unidade</label>
                        <select asp-for="Unidade" class="form-select border-0 border-bottom rounded-0 px-0 shadow-none bg-transparent"
                                asp-items="Html.GetEnumSelectList<Diario_de_Bordo.Models.Estoque.UnidadeMedida>()"></select>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="ValorUnitario" class="form-label small fw-bold text-info text-uppercase">Valor Unitário</label>
                        <input asp-for="ValorUnitario" type="number" step="0.01" class="form-control border-0 border-bottom rounded-0 px-0 shadow-none bg-transparent fw-bold text-info" />
                    </div>
                </div>
            </div>

            @* Coluna da Direita - Foto *@
            <div class="col-md-3 text-center">
                <div class="card border-0 shadow-sm bg-light p-4" style="border-radius: 20px;">
                    <label class="form-label small fw-bold text-secondary text-uppercase mb-4">Imagem do Item</label>
                    <div class="mb-4">
                        <img id="preview" src="@(string.IsNullOrEmpty(Model.FotoPath) ? "/img/placeholder-item.png" : Url.Action("VerFoto", "Estoque", new { path = Model.FotoPath }))"
                             class="rounded-circle border shadow-sm object-fit-cover"
                             style="width: 180px; height: 180px; background-color: #fff;"
                             onerror="this.src='/img/placeholder-item.png';" />
                    </div>
                    <label for="FotoArquivo" class="btn btn-outline-dark btn-sm rounded-pill px-4 w-100">
                        <i class="bi bi-camera me-2"></i>Alterar Foto
                    </label>
                    <input type="file" id="FotoArquivo" name="FotoArquivo" class="d-none" accept="image/*" onchange="previewImage(this)" />
                </div>
            </div>
        </div>

        @* Botões de Ação Final *@
        <div class="mt-5 pt-4 d-flex align-items-center gap-3 border-top border-light">
            <button type="submit" class="btn btn-primary rounded-0 px-5 py-2 fw-bold shadow-sm">
                <i class="bi bi-save me-2"></i>SALVAR ALTERAÇÕES
            </button>

            <button type="button" class="btn btn-outline-dark rounded-0 px-4 py-2 fw-bold" onclick="gerarEtiquetaPreviewLocal()">
                <i class="bi bi-qr-code me-2"></i>GERAR ETIQUETA
            </button>

            <a asp-action="ListagemGeral" class="text-muted text-decoration-none fw-bold small ms-auto">CANCELAR</a>
        </div>
    </form>
</div>

@* MODAL DA ETIQUETA *@
<div class="modal fade" id="modalEtiqueta" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="max-width: 400px; margin: auto;">
            <div class="modal-header bg-dark text-white border-0">
                <h6 class="modal-title fw-bold"><i class="bi bi-printer me-2"></i>PREVIEW DA ETIQUETA</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body bg-light p-4 text-dark">
                <div id="etiquetaReal" class="bg-white shadow-sm mx-auto p-3" style="width: 320px; height: 180px; border: 1px solid #ddd; position: relative;">
                    <div class="d-flex justify-content-between border-bottom pb-1 mb-2">
                        <span style="font-size: 0.6rem; font-weight: bold;">GBR COMPONENTES SMT</span>
                        <span style="font-size: 0.6rem;">@DateTime.Now.ToString("dd/MM/yyyy")</span>
                    </div>
                    <div class="d-flex">
                        @* Container onde o QR Code local será gerado *@
                        <div id="viewQrCodeLocal" class="me-2 bg-white d-flex align-items-center justify-content-center" style="width: 100px; height: 100px;"></div>

                        <div class="flex-grow-1" style="line-height: 1.1;">
                            <label style="font-size: 0.55rem; font-weight: bold; color: #666; display: block; margin-bottom: 0;">P/N FABRICANTE:</label>
                            <span id="viewPN" style="font-size: 0.9rem; font-weight: bold; display: block; margin-bottom: 4px;"></span>

                            <label style="font-size: 0.55rem; font-weight: bold; color: #666; display: block; margin-bottom: 0;">DESCRIÇÃO:</label>
                            <span id="viewDesc" style="font-size: 0.7rem; display: block; height: 32px; overflow: hidden; margin-bottom: 4px;"></span>

                            <div class="mt-2 text-center" style="background: #000; color: #fff; padding: 2px;">
                                <small style="font-size: 0.5rem; display: block; text-transform: uppercase;">Localização</small>
                                <strong id="viewLoc" style="font-size: 1.1rem;"></strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 bg-light">
                <button type="button" class="btn btn-primary btn-sm w-100 fw-bold py-2" onclick="window.print()">
                    <i class="bi bi-printer-fill me-2"></i>IMPRIMIR ETIQUETA
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    // Preview da Imagem no Upload
    function previewImage(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById('preview').src = e.target.result;
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    // Geração de Etiqueta com QR Code Local
    function gerarEtiquetaPreviewLocal() {
        const pn = document.getElementById('inputPN').value;
        const desc = document.getElementById('inputDesc').value;
        const loc = document.getElementById('inputLoc').value;

        if (!pn) {
            alert("Part Number é obrigatório para a etiqueta.");
            return;
        }

        // Preenche textos do modal
        document.getElementById('viewPN').innerText = pn;
        document.getElementById('viewDesc').innerText = desc || "Sem descrição";
        document.getElementById('viewLoc').innerText = loc || "N/A";

        // Limpa e Gera QR Code Localmente
        const qrContainer = document.getElementById('viewQrCodeLocal');
        qrContainer.innerHTML = ""; // Limpa anterior

        new QRCode(qrContainer, {
            text: pn,
            width: 100,
            height: 100,
            colorDark: "#000000",
            colorLight: "#ffffff",
            correctLevel: QRCode.CorrectLevel.H
        });

        // Exibe Modal
        var myModal = new bootstrap.Modal(document.getElementById('modalEtiqueta'));
        myModal.show();
    }
</script>

<style>
    /* Estilo para impressão da etiqueta */
    @@media print {
        body * {
            visibility: hidden;
        }

        #etiquetaReal, #etiquetaReal * {
            visibility: visible;
        }

        #etiquetaReal {
            position: fixed;
            left: 0;
            top: 0;
            width: 80mm; /* Tamanho comum de etiqueta térmica */
            border: none !important;
            box-shadow: none !important;
            padding: 0 !important;
        }
    }
</style>