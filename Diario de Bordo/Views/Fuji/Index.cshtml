<div class="modal fade" id="modalExtracaoLWS" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-robot me-2 text-warning"></i> EXTRAÇÃO LWS (PANASONIC)
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <p class="text-muted mb-4">Selecione o período desejado para a extração dos dados de produção:</p>

                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label fw-bold small text-uppercase">Data/Hora Início</label>
                        <input type="datetime-local" id="lws_inicio" class="form-control form-control-lg border-2" step="60">
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold small text-uppercase">Data/Hora Fim</label>
                        <input type="datetime-local" id="lws_fim" class="form-control form-control-lg border-2" step="60">
                    </div>
                </div>

                <div id="lws-status-feedback" class="mt-3 d-none">
                    <div class="alert alert-info d-flex align-items-center mb-0">
                        <div class="spinner-border spinner-border-sm me-2"></div>
                        <span>Processando extração, aguarde...</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light border-0">
                <button type="button" class="btn btn-secondary fw-bold" data-bs-dismiss="modal">CANCELAR</button>
                <button type="button" class="btn btn-warning fw-bold px-4" onclick="executarExtracaoLWS()">
                    <i class="bi bi-cloud-download me-1"></i> INICIAR EXTRAÇÃO
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalExtracaoUnificada" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" style="z-index: 1060;">
    <div class="modal-dialog modal-lg modal-dialog-centered">
