            // E certifique-se que o controller é 'Fuji'. Se o arquivo for FujiController.cs, use /Fuji/
            $.post('/Fuji/ExecutarRoboLWS', payload)
                .done((res) => {
                    if (res.success) {
                        alert("Extração concluída com sucesso!");
                        $('#modalExtracaoLWS').modal('hide');
                    } else {
                        alert("Aviso: " + res.message);
                    }
                })
                .fail((xhr, status, error) => {
                    // Log mais detalhado no console para você debugar
                    console.error("Erro detalhes:", xhr.responseText);
                    alert("Erro crítico de comunicação. Verifique se a rota /Fuji/ExecutarRoboLWS existe.");
                })
                .always(() => {
                    $('#lws-status-feedback').addClass('d-none');
                    $('.btn-warning').attr('disabled', false);
                });
        }


