        function dispararExtracaoLWS() {
            const agora = new Date();

            // 1. Configura a Data de Hoje às 06:00
            const hojeSeis = new Date();
            hojeSeis.setHours(6, 0, 0, 0);

            // 2. Configura a Data de Ontem às 06:00
            const ontemSeis = new Date();
            ontemSeis.setDate(agora.getDate() - 1);
            ontemSeis.setHours(6, 0, 0, 0);

            // 3. Formata para o padrão exigido pelo input datetime-local (YYYY-MM-DDTHH:mm)
            // Usamos o ajuste de fuso horário local para não dar erro de horas a mais/menos
            const formatarData = (data) => {
                const z = n => (n < 10 ? '0' : '') + n;
                return `${data.getFullYear()}-${z(data.getMonth() + 1)}-${z(data.getDate())}T${z(data.getHours())}:${z(data.getMinutes())}`;
            };

            // 4. Aplica os valores nos inputs
            $('#lws_inicio').val(formatarData(ontemSeis)); // Ontem às 06:00
            $('#lws_fim').val(formatarData(hojeSeis));     // Hoje às 06:00

            // 5. Abre a modal
            $('#modalExtracaoLWS').modal('show');
        }

        function executarExtracaoLWS() {
        const dataInicio = document.getElementById('lws_inicio').value;
            const dataFim = document.getElementById('lws_fim').value;

            if (!dataInicio || !dataFim) {
                alert("Selecione data e hora de início e fim.");
                return;
            }

