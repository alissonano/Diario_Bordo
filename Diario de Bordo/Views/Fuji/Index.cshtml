        // Função chamada pelo botão "EXTRAIR FUJI"
        function dispararExtracaoFuji() {
            const select = $('#fuji_arquivo_select');
            select.html('<option value="">Buscando arquivos no servidor...</option>');

            // Abre a modal primeiro para dar feedback visual
            $('#modalExtracaoFuji').modal('show');

            // Busca a lista de arquivos .xml que começam com "PUS"
            $.get('/Fuji/ObterArquivosDisponiveis')
                .done(function (arquivos) {
                    if (arquivos && arquivos.length > 0) {
                        select.html('<option value="">Selecione um relatório...</option>');
                        arquivos.forEach(arq => {
                            // Formata o nome do arquivo para algo legível: PUS20260416... -> 16/04/2026
                            let dataFormatada = formatarNomeArquivoFuji(arq);
                            select.append(`<option value="${arq}">${dataFormatada} (${arq})</option>`);
                        });
                    } else {
                        select.html('<option value="">Nenhum arquivo encontrado na pasta</option>');
                    }
                })
                .fail(function () {
                    select.html('<option value="">Erro ao conectar com o serviço de arquivos</option>');
                });
        }

        function formatarNomeArquivoFuji(nome) {
            if(nome.length < 11) return nome;
            // Exemplo: PUS20260416...
            const ano = nome.substring(3, 7);
            const mes = nome.substring(7, 9);
            const dia = nome.substring(9, 11);
            return `${dia}/${mes}/${ano}`;
        }

        // Quando clicar em Iniciar Robô na Modal
        function executarExtracaoFuji() {
            const arquivo = $('#fuji_arquivo_select').val();
            // Você precisa pegar o valor da linha de algum lugar (ex: um select de linha ou variável global)
            const linha = $('#fuji_linha_select').val() || "SMD6";

            if (!arquivo) {
                alert("Por favor, selecione um arquivo da lista.");
                return;
            }

            $('#fuji-status-feedback').removeClass('d-none');

            // Alinhando com o Controller:
            // Rota: /Fuji/ProcessarSelecaoModal
            // Parâmetros: nomeArquivo e linha
            $.post('/Fuji/ProcessarSelecaoModal', {
                nomeArquivo: arquivo,
                linha: linha
            })
            .done(function (res) {
                if (res.success) {
                    alert("Sucesso: " + res.message);
                    // Se o controller retornar o nome do arquivo, você pode até oferecer o download aqui
                    $('#modalExtracaoFuji').modal('hide');
                } else {
                    alert("Erro: " + res.message);
                }
            })
            .fail(function (xhr) {
                alert("Erro técnico ao processar o arquivo XML: " + xhr.statusText);
            })
            .always(function () {
                $('#fuji-status-feedback').addClass('d-none');
            });
        }


        // --- LÓGICA NEXIM (SMD1 e SMD8) ---
        function dispararExtracaoNexim() {
            console.log("Iniciando abertura da Modal Nexim...");

            const modalEl = document.getElementById('modalExtracaoNexim');
            const modalNexim = bootstrap.Modal.getOrCreateInstance(modalEl);

            const select = $('#nexim_arquivo_select');

            // 1. Limpa o select e coloca o estado inicial de carregamento
            select.empty().append('<option value="">Buscando ficheiros no servidor Nexim...</option>');

            // 2. Abre a modal via JS (Agora sem conflito com data-attributes)
            modalNexim.show();

            // 3. Busca a lista de arquivos no IP 172.20.100.4
            $.get('/Fuji/ObterArquivosNeximDisponiveis')
                .done(function (arquivos) {
                    console.log("Preenchendo select com arquivos:", arquivos);
                    select.empty();

                    if (arquivos && arquivos.length > 0) {
                        select.append('<option value="">Selecione um relatório Nexim...</option>');

                        $.each(arquivos, function(i, arq) {
                            // Usamos o formatador para a data e pegamos o final do nome (SMD1/SMD8)
                            let dataFormatada = formatarNomeArquivoNexim(arq);
                            let identificadorLinha = arq.split('_').pop().replace('.xlsx', '');

                            select.append($('<option>', {
                                value: arq,
                                text: `${dataFormatada} | ${identificadorLinha}`
                            }));
                        });
                    } else {
                        select.append('<option value="">Nenhum ficheiro encontrado na pasta Auto</option>');
                    }
                })
                .fail(function (xhr) {
                    console.error("Erro na rota Nexim:", xhr.status);
                    select.empty().append('<option value="">Erro de conexão com o servidor Nexim</option>');
                });
        }

        // Formatador exclusivo para o padrão Nexim: 20260416...
        function formatarNomeArquivoNexim(nome) {
            try {
                const ano = nome.substring(0, 4);
                const mes = nome.substring(4, 6);
                const dia = nome.substring(6, 8);
                return `${dia}/${mes}/${ano}`;
            } catch (e) { return nome; }
        }

        function executarExtracaoNexim() {
            const arquivo = $('#nexim_arquivo_select').val();

            if (!arquivo) {
                alert("Por favor, selecione um arquivo da lista.");
                return;
            }

            $('#nexim-status-feedback').removeClass('d-none');
            $('#btnExecutarNexim').prop('disabled', true);

            $.post('/Fuji/ProcessarExtracaoNexim', { arquivoSelecionado: arquivo })
                .done(function (res) {
                    if (res.success) {
                        alert("Sucesso: " + res.message);
                        // Fecha a modal usando a instância do Bootstrap 5
                        bootstrap.Modal.getInstance(document.getElementById('modalExtracaoNexim')).hide();
                    } else {
                        alert("Erro: " + res.message);
                    }
                })
                .fail(function () {
                    alert("Erro técnico ao processar o arquivo Nexim.");
                })
                .always(function () {
                    $('#nexim-status-feedback').addClass('d-none');
                    $('#btnExecutarNexim').prop('disabled', false);
                });
        }


          function abrirCentralExtracao() {
            const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('modalExtracaoUnificada'));
            modal.show();

            // --- CARREGAR NEXIM ---
            $.get('/Fuji/ObterArquivosNeximDisponiveis').done(arquivos => {
                const container = $('#lista-nexim-check').empty();
                arquivos.forEach(arq => {
                    const dataF = formatarNomeArquivoNexim(arq);

                    // Simplificação do nome (Ex: SMD1, SMD8)
                    let nomeSimplificado = "NEXIM";
                    if (arq.includes("_")) {
                        let partes = arq.split('_');
                        nomeSimplificado = partes[partes.length - 1].replace('.xlsx', '');
                    }

                    container.append(`
                        <label class="list-group-item d-flex gap-2 align-items-center">
                            <input class="form-check-input flex-shrink-0 chk-nexim" type="checkbox" value="${arq}">
                            <div class="d-flex justify-content-between w-100">
                                <strong class="text-primary">${dataF}</strong>
                                <span class="badge bg-dark opacity-75">${nomeSimplificado}.XLSX</span>
                            </div>
                        </label>`);
                });
            });

            // --- CARREGAR FUJI (XML) ---
            $.get('/Fuji/ObterArquivosDisponiveis').done(arquivos => {
                const container = $('#lista-fuji-check').empty();
                arquivos.forEach(arq => {
                    let exibicaoData = "Data N/A";

                    // Extrai Data do PUS20260415...
                    if (arq.startsWith("PUS") && arq.length >= 11) {
                        const ano = arq.substring(3, 7);
                        const mes = arq.substring(7, 9);
                        const dia = arq.substring(9, 11);
                        exibicaoData = `${dia}/${mes}/${ano}`;
                    }

                    container.append(`
                        <label class="list-group-item d-flex gap-2 align-items-center">
                            <input class="form-check-input flex-shrink-0 chk-fuji" type="checkbox" value="${arq}">
                            <div class="d-flex justify-content-between w-100">
                                <strong class="text-primary">${exibicaoData}</strong>
                                <span class="badge bg-dark opacity-75">SMT6-9-10.XML</span>
                            </div>
                        </label>`);
                });
            });
        }

        async function executarExtracaoEmMassa() {
            const neximSelecionados = $('.chk-nexim:checked').map((i, el) => el.value).get();
            const fujiSelecionados = $('.chk-fuji:checked').map((i, el) => el.value).get();

            if (neximSelecionados.length === 0 && fujiSelecionados.length === 0) {
                alert("Selecione ao menos um arquivo.");
                return;
            }

            $('#status-feedback-unificado').removeClass('d-none');
            $('#btnExecutarMassa').prop('disabled', true);

            // Processar NEXIM um por um
            for (let arq of neximSelecionados) {
                $('#msg-status-unificado').text(`Processando Nexim: ${arq}...`);
                await $.post('/Fuji/ProcessarExtracaoNexim', { arquivoSelecionado: arq });
            }

            // Processar FUJI um por um
            for (let arq of fujiSelecionados) {
                $('#msg-status-unificado').text(`Processando Fuji: ${arq}...`);
                await $.post('/Fuji/ProcessarSelecaoModal', { nomeArquivo: arq });
            }

            alert("Todas as extrações foram concluídas!");
            location.reload(); // Recarrega para atualizar os dados na tela
        }

    </script>
