        function calcularDadosIndex(realizado, metaHora) {
                    const agora = new Date();
                    const minAtual = agora.getHours() * 60 + agora.getMinutes();
                    let inicioTurno;

                    if (minAtual >= 360 && minAtual < 840) inicioTurno = 360;
                    else if (minAtual >= 840 && minAtual < 1320) inicioTurno = 840;
                    else inicioTurno = (minAtual >= 1320) ? 1320 : (1320 - 1440);

                    let decorrido = minAtual - inicioTurno;
                    let tempoProducaoEfetiva = decorrido;
                    if (decorrido > 240) tempoProducaoEfetiva -= 60;
                    tempoProducaoEfetiva = Math.max(0, Math.min(tempoProducaoEfetiva, 420));

                    const metaProporcional = (metaHora / 60) * tempoProducaoEfetiva;
                    const ef = metaProporcional > 0 ? Math.round((realizado / metaProporcional) * 100) : 0;
                    return { ef: ef };
                }
        // --- FUNÇÕES AUXILIARES DE CÁLCULO DE TEMPO ---

        function tToM(timeStr) {
            if (!timeStr) return 0;
            const parts = timeStr.split(':');
            return (parseInt(parts[0]) * 60) + parseInt(parts[1]);
        }

        function calcularMetaTurnoDinamica(res, metaHora) {
            const agora = new Date();
            const minAtual = agora.getHours() * 60 + agora.getMinutes();
            const diaSemana = agora.getDay();
            const diasMap = ['dom', 'seg', 'ter', 'qua', 'qui', 'sex', 'sab'];
            const hojeProp = diasMap[diaSemana];

            // 1. Identificar horários do turno atual que veio do banco
            let mIni = 0, mFim = 0;

            // Lógica de identificação de turno baseada nos horários configurados
            const t1I = tToM(res.t1Inicio), t1F = tToM(res.t1Fim);
            const t2I = tToM(res.t2Inicio), t2F = tToM(res.t2Fim);
            const t3I = tToM(res.t3Inicio), t3F = tToM(res.t3Fim);

            if (minAtual >= t1I && minAtual < t1F) { mIni = t1I; mFim = t1F; }
            else if (minAtual >= t2I && minAtual < t2F) { mIni = t2I; mFim = t2F; }
            else { mIni = t3I; mFim = t3F; }

            // 2. Duração Total do Turno (Tratando virada de meia-noite)
            let duracaoTotal = mFim - mIni;
            if (duracaoTotal < 0) duracaoTotal += 1440;

            // 3. Somar descontos das paradas programadas para HOJE dentro deste turno
            let desconto = 0;
            if (res.paradasProgramadas && res.paradasProgramadas.length > 0) {
                res.paradasProgramadas.forEach(p => {
                    // Verifica se a parada está marcada para o dia de hoje (ex: p.seg === true)
                    if (p[hojeProp] === true) {
                        let pIni = tToM(p.inicio);
                        let pFim = tToM(p.fim);
                        let pDur = pFim - pIni;
                        if (pDur < 0) pDur += 1440;

                        // Cálculo de intersecção (Overlap) entre Turno e Parada
                        let overlaps = [
                            { s: pIni, e: pIni + pDur },
                            { s: pIni + 1440, e: pIni + pDur + 1440 },
                            { s: pIni - 1440, e: pIni + pDur - 1440 }
                        ];

                        overlaps.forEach(over => {
                            let startMax = Math.max(mIni, over.s);
                            let endMin = Math.min(mIni + duracaoTotal, over.e);
                            let intersection = endMin - startMax;
                            if (intersection > 0) desconto += intersection;
                        });
                    }
                });
            }

            const minutosProdutivos = duracaoTotal - desconto;
            return Math.round((metaHora / 60) * minutosProdutivos);
        }

        // --- FUNÇÕES PRINCIPAIS ---

