                        console.log("Áudio desbloqueado e ativado.");
                    } else {
                        $('#btnSom').removeClass('bi-volume-up-fill text-primary').addClass('bi-volume-mute-fill text-secondary');
                        console.log("Áudio silenciado.");
                    }
                });

                        function abrirFullscreen() {
