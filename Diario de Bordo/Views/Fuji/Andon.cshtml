        // --- 2. CAPTURA GLOBAL DO SCANNER (QR CODE) ---
        $(document).on('keydown', function(e) {
            // Se o foco estiver num campo de texto (textarea/input), deixa o comportamento padrão
            if ($(e.target).is('input, textarea')) return;

            if (e.which === 13) { // Tecla Enter (Fim do Bipe)
                let codigoLimpo = bufferBipe.trim().toUpperCase();

                if (codigoLimpo.length > 0) {
                    console.log("%c[AURA] Bipe Detectado: " + codigoLimpo, "color: #f59e0b; font-weight: bold;");
                    processarBipeUnificado(codigoLimpo);
                }
                bufferBipe = "";
                e.preventDefault();
            } else {
                // Captura apenas caracteres válidos (ignora Shift, Alt, etc)
                if (e.key.length === 1) {
                    bufferBipe += e.key;
                }
            }
        });

        // --- 3. LÓGICA DE DECISÃO: ESTRATIFICAR VS EDITAR ---
        function processarBipeUnificado(motivo) {
            emTransicaoDeBipe = true;

            // Decidimos qual endpoint chamar baseado no prefixo "SETUP-"
            const ehSetup = motivo.startsWith("SETUP-");
            const urlEndpoint = ehSetup ? '/Fuji/ProcessarBipeSetup' : '/Fuji/SalvarJustificativa';

            // Preparamos o objeto de dados (ajustado para os dois tipos de controller)
            const dados = ehSetup
                ? { Linha: linha, MotivoBipado: motivo, Produto: $('#nomePrograma').text().split(' [')[0], Lado: (linha === 'SMD1' ? 'T' : 'B') }
                : { id: idParadaAtualAtiva, motivo: motivo };

            console.log(`[AURA] Enviando para: ${urlEndpoint}`, dados);

            $.ajax({
                url: urlEndpoint,
                type: 'POST',
                // Se for Setup mandamos JSON, se for Justificativa mandamos Form normal
                data: ehSetup ? JSON.stringify(dados) : dados,
                contentType: ehSetup ? 'application/json' : 'application/x-www-form-urlencoded',
        success: function(res) {
            if (res.success) {
                if (ehSetup) {
                    idParadaAtualAtiva = res.idNovo;
                    // DISPARA O OVERLAY IMEDIATAMENTE USANDO A HORA ATUAL
                    gerenciarOverlaySetup(motivo, res.timestampInicio);
                } else {
                    // Se for justificativa normal (ex: REUNIAO), fecha o overlay se estiver aberto
                    gerenciarOverlaySetup(null, null);
                }

                $('#motivoParada').text(motivo).addClass('text-warning');
                if (somAtivado) document.getElementById('audioSucesso').play();

                console.log(`%c[AURA] Sucesso: ${motivo}`, "color: #10b981; font-weight: bold;");

                setTimeout(() => { emTransicaoDeBipe = false; }, 5000);
            }
        },
                error: function() {
                    console.error("[AURA] Erro de comunicação.");
                    emTransicaoDeBipe = false;
                }
            });
        }


