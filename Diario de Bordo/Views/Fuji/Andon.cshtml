        function verificarTaktAutomatico(realizado, meta, pan, res, lado, multiplicador) {
            // 1. Filtro de Segurança: Só prossegue se a linha atual estiver na lista

                    // 1. Checa se estamos em horário de PARADA PROGRAMADA
            const paradaProgramada = obterParadaAtiva(res.paradasProgramadas);

