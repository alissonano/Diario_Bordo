        function calcularDadosSincronizados(realizado, metaHora) {
            const agora = new Date();
            const minDia = agora.getHours() * 60 + agora.getMinutes();
            let inicio = 0, nome = "";
            if (minDia >= 360 && minDia < 840) { inicio = 360; nome = "1º TURNO"; }
            else if (minDia >= 840 && minDia < 1320) { inicio = 840; nome = "2º TURNO"; }
            else { inicio = (minDia >= 1320) ? 1320 : (1320 - 1440); nome = "3º TURNO"; }

            let decorrido = minDia - inicio;
            if (decorrido < 0) decorrido += 1440;
            let minProdutivos = decorrido > 240 ? decorrido - 60 : decorrido;
            if (minProdutivos < 0) minProdutivos = 0;
            if (minProdutivos > 420) minProdutivos = 420;

            const metaAteAgora = (metaHora / 60) * minProdutivos;
            let ef = metaAteAgora > 0 ? (realizado / metaAteAgora) * 100 : 0;
            return { nome: nome, ef: Math.min(Math.round(ef), 150) };
        }
