@* Views/Fuji/Andon.cshtml *@
@{
    Layout = null;
    var linha = Context.Request.Query["line"].ToString() ?? "SMD 8";
}

<audio id="audioSucesso" src="~/sounds/wolfy_sanic-chaos-emerald-15983.mp3" preload="auto"></audio>
<audio id="audioAlerta" src="~/sounds/negative.mp3" preload="auto"></audio>


<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ANDON SYSTEM - @linha</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css">

    <style>
        :root {
            --bg-page: #f1f5f9;
            --bg-card: #ffffff;
            --text-dark: #000000;
            --ok-color: #10b981;
            --warning-color: #f59e0b;
            --danger-color: #ef4444;
        }

        body, html {
            height: 100%;
            margin: 0;
            background-color: var(--bg-page);
            font-family: 'Inter', 'Segoe UI', sans-serif;
            overflow: hidden;
            color: var(--text-dark);
        }

        .andon-grid {
            height: 100vh;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            grid-template-rows: 14vh 28vh 28vh 22vh; /* Linhas: Header, Dados 1, Dados 2, Footer */
            gap: 15px;
            padding: 15px;
            box-sizing: border-box;
        }

        /* Padronização de Tiles */
        .tile {
            background: var(--bg-card);
            border-radius: 12px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            border: 1px solid #e2e8f0;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            padding: 10px;
            text-align: center;
            width: 100%;
            height: 100%;
            overflow: hidden;
        }
        /* Container que limita a largura */
        .marquee-container {
            width: 100%;
            overflow: hidden;
            white-space: nowrap;
            position: relative;
        }

        /* Classe que será aplicada via JS se o texto for grande */
        .marquee-active {
            display: inline-block;
            padding-left: 100%;
            animation: marquee-animation 15s linear infinite;
        }

        @@keyframes marquee-animation {
            0%

        {
            transform: translate(0, 0);
        }

        100% {
            transform: translate(-100%, 0);
        }

        }

        .setup-fullscreen {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: radial-gradient(circle, #1a1c2c 0%, #000 100%);
            z-index: 99999;
            display: flex;
            flex-direction: column; /* Organiza itens em coluna */
            justify-content: center;
            align-items: center;
            color: white;
            text-align: center;
            padding: 2vh; /* Margem de segurança de 2% da altura */
            box-sizing: border-box;
            overflow: hidden; /* Garante que não apareça barra de rolagem */
        }

        .setup-content {
            width: 95vw; /* Ocupa 95% da largura da tela */
            max-height: 95vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        .setup-header {
            /* Responsivo: mínimo 20px, ideal 3% da largura, máximo 50px */
            font-size: clamp(20px, 3vw, 50px);
            font-weight: 900;
            color: #f59e0b;
            letter-spacing: 2px;
            margin-bottom: 2vh;
            text-transform: uppercase;
        }

        .setup-etapa {
            /* Responsivo: ideal 6% da largura */
            font-size: clamp(30px, 6vw, 100px);
            font-weight: 800;
            text-transform: uppercase;
            background: #f59e0b;
            color: #000;
            display: inline-block;
            padding: 1vh 4vw;
            border-radius: 1vw;
            margin-bottom: 2vh;
            white-space: nowrap; /* Não deixa o nome da etapa quebrar linha */
        }

        .setup-timer {
            /* O "PULO DO GATO": O tamanho da fonte baseia-se na largura da tela (vw) */
            /* 20vw significa 20% da largura total da tela */
            font-size: 20vw;
            font-family: 'Consolas', 'Courier New', monospace;
            font-weight: 900;
            line-height: 0.8;
            margin: 0;
            color: #fff;
            font-variant-numeric: tabular-nums;
            letter-spacing: -1vw; /* Aproxima um pouco os números */
            text-shadow: 0 0 50px rgba(255, 255, 255, 0.1);
        }

        .setup-footer {
            font-size: clamp(15px, 2vw, 35px);
            color: #475569;
            margin-top: 3vh;
            font-weight: 600;
        }

        .timer-danger {
            color: #ef4444 !important;
            text-shadow: 0 0 60px rgba(239, 68, 68, 0.6) !important;
            animation: pulse-red 1s infinite alternate;
        }

        .overlay-danger {
    background: radial-gradient(circle, #450a0a 0%, #000 100%) !important;
    border: 10px solid #ef4444;
}

        @@keyframes pulse-red {
            from

        {
            transform: scale(1);
        }

        to {
            transform: scale(1.03);
        }

        }
        .program-name {
            font-size: 2.5rem;
            color: yellow;
            font-weight: 500;
            text-transform: uppercase;
            margin-top: 1px;
        }

        /* Header Tiles */
        .tile-header-logo {
            grid-column: 1;
        }

        .tile-header-banner {
            grid-column: 2 / 4;
            background: var(--text-dark);
            color: white;
        }

        /* Tiles Grandes Centrais */
        .tile-large {
            grid-row: 2 / 4;
            border: 3px solid #cbd5e1;
        }

        .total-position {
            grid-column: 2;
        }

        .eff-position {
            grid-column: 3;
        }

        /* Textos */
        .line-title {
            font-size: 5.0rem;
            font-weight: 900;
            line-height: 1;
        }



        .label {
            font-size: 2.2rem;
            font-weight: 700;
            text-transform: uppercase;
            color: #1e293b;
        }

        .value {
            font-size: 6rem;
            font-weight: 800;
            line-height: 1;
        }

        .alert-stop {
            background: #fff1f2 !important;
            border: 4px solid var(--danger-color) !important;
        }

        .overlay-sem-meta {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(0, 0, 0, 0.75); /* 0.75 = 75% opaco — ajuste a gosto */
            backdrop-filter: blur(3px); /* leve desfoque no fundo, opcional */
            z-index: 99998;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: white;
            text-align: center;
            animation: piscar-borda 1.2s ease-in-out infinite alternate;
        }

        .sem-meta-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 3vw;
            background: #f59e0b;
            color: #000;
            /* Tamanho de fonte que escala com a largura da tela (5% da largura) */
            font-size: 5vw;
            font-weight: 900;
            letter-spacing: 0.5vw;
            text-transform: uppercase;
            padding: 3vh 6vw;
            border-radius: 2vw;
            margin-bottom: 5vh;
            animation: pulsar-badge 1.2s ease-in-out infinite alternate;
            box-shadow: 0 0 50px rgba(245, 158, 11, 0.5);
        }

        .sem-meta-subtitulo {
            /* 2% da largura da tela é perfeito para 50 polegadas */
            font-size: 2.2vw;
            color: #cbd5e1;
            background: transparent;
            font-weight: 600;
            letter-spacing: 0.1vw;
            text-transform: uppercase;
            margin-top: 2vh;
            max-width: 80vw; /* Limita a largura do texto para não esticar demais */
            line-height: 1.4;
        }

        @@keyframes pulsar-badge {
            from

        {
            transform: scale(1);
        }

        to {
            transform: scale(1.04);
        }

        }

        @@keyframes piscar-borda {
            from

        {
            outline: 8px solid transparent;
        }

        to {
            outline: 8px solid #f59e0b;
        }

        }

        #effIcon {
            font-size: 40rem !important; /* Emoji Gigante */
            line-height: 1;
            margin-top: 10px;
            margin-bottom: 5px;
            transition: all 0.5s ease; /* Transição suave na troca de ícone */
        }



        /* Valor da eficiência menor e logo abaixo */
        #effValue {
            font-size: 6rem !important;
            font-weight: 900;
            margin-bottom: 10px;
        }

        /* Ajuste no motivo da parada para não embolar */
        #motivoParada {
            font-size: 2.0rem;
            letter-spacing: 1px;
        }
    </style>
</head>
<body>

    <div class="andon-grid">
        <div class="tile tile-header-logo">

            <img src="~/images/gbr-logo.png" alt="Logo" style="max-height: 78%; max-width: 85%; object-fit: contain;" />

        </div>

        <div class="tile tile-header-banner">
            <div class="d-flex align-items-center gap-4">
                <div class="line-title">@linha.ToUpper()</div>
            </div>

            <div class="marquee-container">
                <div id="nomePrograma" class="program-name">AGUARDANDO...</div>
            </div>
        </div>

        <div class="tile">
            <div class="label" style="font-size: 4.0rem;">META HORA</div>
            <div class="value" id="metaHora" style="font-size: 10rem;">0</div>
        </div>

        <div class="tile">
            <div class="label" style="font-size: 4.0rem;">META TURNO</div>
            <div class="value" id="metaDia" style="font-size: 10rem;">0</div>
        </div>

        <div class="tile tile-large total-position">
            <div class="label" style="font-size: 4.0rem;">TOTAL ACUMULADO</div>
            <div class="value" id="totalAcumulado" style="font-size: 10rem;">0</div>
            <div class="value" style="font-size: 4.0rem; color: black; margin-top: 15px;">PEÇAS PRODUZIDAS</div>
        </div>

        <div id="tileEficiencia" class="tile tile-large eff-position">
            <div class="label" style="font-size: 4.0rem;">EFICIÊNCIA</div>

            <div id="effIcon">
                <img id="gbotAnimado" src="~/EMOJI/thinking-about.gif" style="height: 180px; width: auto; object-fit: contain;" />
            </div>

            <div id="effValue" class="value">0%</div>

            <div id="motivoParada" class="fw-bold text-uppercase">OPERANDO</div>
        </div>

        <div class="tile">
            <div id="dataHeader" class="fw-bold" style="font-size: 4.0rem; color: black;">--/--/----</div>
            <div id="relogioHeader" class="value" style="font-size: 4.5rem;">00:00:00</div>
        </div>


        <div class="tile">
            <div class="label" style="font-size: 3.0rem;">TURNO</div>
            <div id="turnoNome" class="value" style="font-size: 4.5rem;">---</div>
        </div>
        <div class="tile">
            <div class="label" style="font-size: 3.0rem;">STATUS</div>
            <div id="statusConexaoContainer" class="value" style="font-size: 4.5rem; display: flex; align-items: center; gap: 20px; cursor: pointer;">
                <span id="statusConexao" style="color: var(--ok-color);">ONLINE</span>
                <i id="btnSom" class="bi bi-volume-mute-fill text-secondary"></i>
            </div>
        </div>
    </div>

    <div id="overlaySetup" class="setup-fullscreen" style="display: none;">
        <div class="setup-content">
            <div class="setup-header">PROCESSO DE SETUP EM ANDAMENTO</div>
            <div id="setupEtapaNome" class="setup-etapa">CARREGANDO...</div>
            <div id="setupCronometroGigante" class="setup-timer">00:00:00</div>
            <div class="setup-footer">BIPE O PRÓXIMO QR CODE PARA AVANÇAR</div>
        </div>
    </div>
    <div id="overlaySemMeta" class="overlay-sem-meta" style="display:none;">
        <div class="sem-meta-badge">
            ⚠&nbsp; SEM META DEFINIDA &nbsp;⚠
        </div>
        <div class="sem-meta-subtitulo">
            Solicitar definição de meta para o responsável de planejamento ou supervisão. O sistema não consegue calcular a eficiência sem essa informação.
        </div>
        <div style="margin-top: 2vh; font-size: clamp(12px, 1.2vw, 18px); color: #475569;">
            ANDON SYSTEM — MONITORAMENTO INATIVO
        </div>
    </div>

    <div class="modal fade" id="modalJustificativa" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-danger shadow-lg">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        JUSTIFICATIVA PARA A PARADA <span id="labelIdParada" class="badge bg-white text-danger">#0000</span>
                    </h5>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="inputMotivoReal" class="form-label fw-bold">Por que a linha parou?</label>
                        <textarea class="form-control form-control-lg" id="inputMotivoReal" rows="3" placeholder="Ex: Falha técnica, falta de material, troca de modelo..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <span id="msgSalvando" class="text-muted small me-auto" style="display:none;">
                        <i class="fas fa-spinner fa-spin"></i> Salvando no diário...
                    </span>
                    <button type="button" class="btn btn-secondary fw-bold" data-bs-dismiss="modal">CANCELAR</button>
                    <button type="button" id="btnSalvarJustificativa" class="btn btn-danger px-4 fw-bold" onclick="salvarJustificativaManual()">
                        SALVAR
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        let somAtivado = true; // <-- Ela TEM que estar aqui em cima
        const linha = "@linha";
        let ultimaQtd = -1;
        let segundosInativo = 0;
        const linhaAtual = new URLSearchParams(window.location.search).get('line') || 'SMD1';
        let falhasConsecutivas = 0;
        let emModoRecuperacao = false;
        let servidorOffline = false
        let idParadaAtualAtiva = null;
                let timerAutoCloseModal = null; // Variável para controlar o tempo da modal

        const linhasHabilitadasAutoStop = ["SMD1"];



        $('#btnAndon').attr('href', '/Fuji/Andon?line=' + linhaAtual);

                function iniciarTimerFechamentoModal() {
            // Limpa qualquer timer anterior para não haver conflito
            if (timerAutoCloseModal) clearTimeout(timerAutoCloseModal);

            // Inicia a contagem de 20 segundos (20000ms)
            timerAutoCloseModal = setTimeout(() => {
                const modalElement = document.getElementById('modalJustificativa');
                const modalInstance = bootstrap.Modal.getInstance(modalElement);

                if (modalInstance && $('#modalJustificativa').hasClass('show')) {
                    modalInstance.hide();
                    console.log("[AURA] Modal fechada automaticamente após 20s.");
                }
            }, 20000);
        }


                let monitorTransicao = null;

        function verificarTransicao() {
            console.log("[AURA DEBUG] 1. Iniciando chamada ao endpoint...");

            $.get('/Fuji/ObterStatusTransicao', { linha: 'SMD1' })
                .done(function(res) {
                    console.log("[AURA DEBUG] 2. Resposta do Servidor:", res);

                    // Lógica: Se a quantidade do novo é 0, o cronómetro continua
                    if (res.modelo_novo_qtd === 0) {
                        console.log("[AURA DEBUG] 3. Modelo Novo com Qtd 0. Disparando Modal.");
                        exibirModalSetup(res.timestamp_fim_a, res.modelo_anterior);
                    } else {
                        console.log("[AURA DEBUG] 3. Modelo Novo detetado (" + res.modelo_novo + "). Fechando Modal.");
                        fecharModalSetup();
                    }
                })
                .fail(function(xhr, status, error) {
                    console.error("[AURA ERROR] Falha Crítica no AJAX:");
                    console.error("Status: " + status);
                    console.error("Erro: " + error);
                    console.error("Resposta completa: ", xhr.responseText);
                });
        }
                let setupTimerInterval = null;

        function formatarTempo(totalSegundos) {
            const horas = Math.floor(totalSegundos / 3600);
            const minutos = Math.floor((totalSegundos % 3600) / 60);
            const segundos = totalSegundos % 60;
            return [horas, minutos, segundos].map(v => v < 10 ? "0" + v : v).join(":");
        }

        function gerenciarOverlaySetup(motivo, dataInicio) {
            if (motivo && motivo.toUpperCase().startsWith("SETUP-")) {
                $('#overlaySetup').show();
                $('#setupEtapaNome').text(motivo.replace("SETUP-", ""));
                iniciarCronometroGigante(dataInicio);
            } else {
                $('#overlaySetup').hide();
                if (setupTimerInterval) clearInterval(setupTimerInterval);
            }
        }

        function iniciarCronometroGigante(dataInicio) {
            if (setupTimerInterval) clearInterval(setupTimerInterval);

            // Converte a string de data vinda do banco para o objeto Date do JS
            const startTime = new Date(dataInicio).getTime();

            // --- CÁLCULO IMEDIATO (Para evitar o 00:00:00 inicial) ---
            const atualizarTick = () => {
                const agora = new Date().getTime();
                const diffSegundos = Math.floor((agora - startTime) / 1000);

                if (diffSegundos >= 0) {
                    const tempoFormatado = formatarTempo(diffSegundos);
                    $('#setupCronometroGigante').text(tempoFormatado);

                    // Alerta visual se passar de 20 minutos (1200s)
                    if (diffSegundos > 1200) {
                        $('#setupCronometroGigante').addClass('timer-danger');
                        $('#overlaySetup').addClass('overlay-danger');
                    } else {
                        $('#setupCronometroGigante').removeClass('timer-danger');
                        $('#overlaySetup').removeClass('overlay-danger');
                    }
                }
            };

            // Executa uma vez agora
            atualizarTick();

            // E depois executa a cada 1 segundo
            setupTimerInterval = setInterval(atualizarTick, 1000);
        }


          function atualizar() {
            $.get('/Fuji/ObterStatusAtual?line=' + linha)
                .done(function (res) {

                    // 1. CHECAGEM DE APP_OFFLINE (Se o IIS devolveu HTML em vez de JSON)
                    if (typeof res === 'string' && res.indexOf('<!DOCTYPE') > -1) {
                        lidarComServidorOffline("Servidor em Manutenção...");
                        return;
                    }

                    // 2. RECUPERAÇÃO (Se estava offline e agora voltou)
                    if (servidorOffline) {
                        console.log("Conexão restabelecida. Recarregando...");
                        location.reload();
                        return;
                    }

                    // 3. PROCESSAMENTO NORMAL
                    if (res.success) {
                        console.log("Parada já existe no banco?", res.paradaEmAberto);
                        servidorOffline = false;
                        $('#avisoUpdate').hide();
                        $('#statusConexao').text("ONLINE").css('color', 'var(--ok-color)');

                        const metaNominal = res.meta || 0;
                        const realizadoTurno = res.produzidoHora || 0;
                        const pan = res.panelizacao || 1;
                        const info = calcularDadosSincronizados(realizadoTurno, metaNominal);
                        const metaTurnoReal = calcularMetaTurnoDinamica(res, metaNominal);

                                // --- ATUALIZAÇÃO DOS VALORES VINDOS DO CONTROLLER ---
                        const produzidoReal = res.produzidoHora || 0;
                        const metaHoraNominal = res.meta || 0;

                        // Meta do Dia já descontando as paradas (Ex: 700)
                        const metaDiaReal = res.metaDia || 0;

                        // Meta proporcional que "congela" no almoço (Ex: 150)
                        const metaAteAgoraReal = res.metaAteAgora || 0;

                        // CAPTURA A TOLERÂNCIA DO BANCO
                        const multDinamico = res.toleranciaTakt || 3;

                        ultimaEficienciaGeral = info.ef;

                        // --- ATUALIZAÇÃO DO LADO ---
                        const ladoTexto = res.lado === "T" ? "TOP" : "BOT";
                        const programaFull = res.produto ? `${res.produto} [ ${ladoTexto} ]` : "NENHUM PROGRAMA ATIVO";

                        // --- LOGICA DO MARQUEE ---
                        const $progEl = $('#nomePrograma');
                        $progEl.text(programaFull);
                        $progEl.removeClass('marquee-active');

                        const containerWidth = $progEl.parent().width();
                        const textWidth = $progEl[0].scrollWidth;

                        if (textWidth > containerWidth) {
                            $progEl.addClass('marquee-active');
                        }

                        // UI Updates Gerais
                        $('#totalAcumulado').text(produzidoReal);
                        $('#metaHora').text(metaHoraNominal);
                        $('#metaDia').text(metaDiaReal); // Exibe a meta justa para o operador
                        $('#turnoNome').text(info.nome);
                        $('#effValue').text(info.ef + "%");

                        // Dashboard de Turnos
                        $('#producaoP1').text(res.producao1T || 0);
                        $('#producaoP2').text(res.producao2T || 0);
                        $('#producaoP3').text(res.producao3T || 0);


                        const gbotEl = $('#gbotAnimado');
                        const acumuladoEl = $('#totalAcumulado');
        if (metaHoraNominal === 0) {
            $('#overlaySemMeta').show();
        } else {
            $('#overlaySemMeta').hide();
        }

        // 1. PRIORIDADE: Se a linha está parada, o GIF deve ser o de "Parado/Alerta"
        if (res.paradaEmAberto) {

            gbotEl.attr('src', '/EMOJI/thinking-about.gif');
            acumuladoEl.css('color', 'var(--danger-color)');
        }
        // 2. Eficiência EXCELENTE (>= 95%)
        else if (info.ef >= 95) {
            gbotEl.attr('src', '/EMOJI/very-happy-emoji.gif');
            acumuladoEl.css('color', 'var(--ok-color)');
        }
        // 3. Eficiência BOA (>= 85%)
        else if (info.ef >= 85) {
                    gbotEl.attr('src','/EMOJI/happy-emoji.gif');
            acumuladoEl.css('color', 'var(--ok-color)');
        }
        // 4. Eficiência ATENÇÃO (>= 80%)
        else if (info.ef >= 80) {
                    gbotEl.attr('src', '/EMOJI/tired-emoji-emoji-tired.gif');
            acumuladoEl.css('color', 'var(--warning-color)');
        }
        // 5. Eficiência BAIXA (< 80%)
        else {
                    gbotEl.attr('src', '/EMOJI/crying-emoji.gif');
            acumuladoEl.css('color', 'var(--danger-color)');
        }

                        // Status de Parada
        if (res.paradaEmAberto) {

            console.log("Parada já existe no banco?", res.paradaEmAberto);
            // 1. Atualização Visual do Card
            $('#tileEficiencia').addClass('alert-stop');

            // Pegamos o motivo que veio do banco (ou o padrão se estiver vazio)
            const motivoNoBanco = res.motivoParada || "INATIVIDADE AUTOMATICA";
            $('#motivoParada').text(motivoNoBanco).addClass('text-danger');

            // 2. Sincronização do ID
            const idDoServidor = res.idParadaEmAberto || res.idParada;

            if (idDoServidor) {
                idParadaAtualAtiva = idDoServidor;

                // 3. Atualiza o ID no cabeçalho da Modal conforme solicitado
                $('#labelIdParada').text('#' + idParadaAtualAtiva);

                // 4. Preparação da Modal
                $('#btnSalvarJustificativa').prop('disabled', false);
                $('#msgAguarde').hide();

                // --- NOVA CONDICIONAL DE JUSTIFICATIVA ---
                // Lista de motivos que o sistema gera sozinho (Watchdog)
                const motivosSistema = [
