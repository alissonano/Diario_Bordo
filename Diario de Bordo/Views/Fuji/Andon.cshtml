                    const somParaTocar = (ultimaEficienciaGeral >= 85) ? somSucesso : somAlerta;

                    if (somParaTocar) {
                        somParaTocar.currentTime = 0;
                        somParaTocar.play().catch(e => console.error("Erro ao reproduzir áudio:", e));
                        console.log("Som executado. Eficiência atual:", ultimaEficienciaGeral + "%");
                    }
