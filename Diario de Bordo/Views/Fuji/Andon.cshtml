        function calcularMetaTurnoDinamica(res, metaHora) {
            const agora = new Date();
            const minAtual = agora.getHours() * 60 + agora.getMinutes();

            // 1. Identificar qual o turno atual e seus horários (convertendo HH:mm para minutos totais)
            let inicioTurnoMins = 0;
            let fimTurnoMins = 0;

            // Lógica simplificada para identificar o turno (ajuste conforme sua regra de Manaus)
            if (minAtual >= 360 && minAtual < 840) { // 06:00 - 14:00
                inicioTurnoMins = converterParaMinutos(res.t1Inicio) || 360;
                fimTurnoMins = converterParaMinutos(res.t1Fim) || 840;
            } else if (minAtual >= 840 && minAtual < 1320) { // 14:00 - 22:00
                inicioTurnoMins = converterParaMinutos(res.t2Inicio) || 840;
                fimTurnoMins = converterParaMinutos(res.t2Fim) || 1320;
            } else { // 3º Turno (Lida com a virada da meia-noite)
                inicioTurnoMins = converterParaMinutos(res.t3Inicio) || 1320;
                fimTurnoMins = converterParaMinutos(res.t3Fim) || 360;
            }

            // 2. Calcular tempo total do turno em minutos
            let tempoTotalTurno = fimTurnoMins - inicioTurnoMins;
            if (tempoTotalTurno < 0) tempoTotalTurno += 1440; // Ajuste para o 3º turno

            // 3. Subtrair minutos de paradas programadas que pertencem a este turno e ao dia de hoje
            let minutosParadas = 0;
            const diaSemana = agora.getDay();
            const diasMap = ["dom", "seg", "ter", "qua", "qui", "sex", "sab"];
            const hojeProp = diasMap[diaSemana];

            if (res.paradasProgramadas) {
                res.paradasProgramadas.forEach(p => {
                    if (p[hojeProp]) { // Se a parada se aplica ao dia de hoje
                        const pIni = converterParaMinutos(p.inicio);
                        const pFim = converterParaMinutos(p.fim);

                        // Verifica se a parada está dentro da janela do turno atual
                        if (pIni >= inicioTurnoMins && pIni < (inicioTurnoMins + tempoTotalTurno)) {
                            let duracao = pFim - pIni;
                            if (duracao < 0) duracao += 1440;
                            minutosParadas += duracao;
                        }
                    }
                });
            }

            const minutosProdutivos = tempoTotalTurno - minutosParadas;

            // 4. Meta do Turno = (Meta Hora / 60) * Minutos Produtivos
            return Math.round((metaHora / 60) * minutosProdutivos);
        }

        // Função auxiliar para converter "06:00" em 360
        function converterParaMinutos(horarioStr) {
            if (!horarioStr) return null;
            const partes = horarioStr.split(':');
            return parseInt(partes[0]) * 60 + parseInt(partes[1]);
        }


