            if (paradaProgramada) {
                console.log(`[AURA] Parada Programada Detectada: ${paradaProgramada.descricao}`);

                // UI: Mostra o aviso na tela
                $('#tileEficiencia').removeClass('alert-stop').addClass('bg-info-subtle'); // Cor azul clara/info
                $('#motivoParada').text(paradaProgramada.descricao).css('color', '#055160'); // Texto azul escuro

                ultimaQtd = realizado; // Sincroniza para não abrir parada assim que o horário acabar
                return; // MATA A EXECUÇÃO AQUI (Não abre parada automática)
            }


            if (!linhasHabilitadasAutoStop.includes(linha)) {
                ultimaQtd = realizado;
                return;
            }

            // 2. Configuração do Takt Alvo e Limite Dinâmico
            // Usamos o multiplicador que vem da configuração da linha (ou 3 como padrão/fallback)
            const mult = multiplicador || 3;
            const taktAlvoSegundos = meta > 0 ? (3600 / (meta / pan)) : 60;
            const limite = taktAlvoSegundos * mult;

            const ladoIdentificado = res.lado || (typeof ladoAtual !== 'undefined' ? ladoAtual : 'T');

            // 3. Cálculo da Inatividade Real
            const agora = new Date();
            const ultimaPlaca = new Date(res.timestampUltimaPlaca);
            const segundosInativoReal = Math.floor((agora - ultimaPlaca) / 1000);

            console.group(`%c[WATCHDOG AURA] - ${agora.toLocaleTimeString()}`, "color: #007bff; font-weight: bold;");
            console.log(`Meta: ${res.meta} | Último Registro Real: %c${res.timestampUltimaPlaca} {`, "color: #e83e8c; font-weight: bold;");

            // Status Visual no Console para depuração (Agora mostrando o multiplicador real)
            const corStatus = segundosInativoReal >= limite ? "color: red; font-weight: bold;" : "color: green;";
            console.log(`Tempo Inativo: %c${segundosInativoReal}s %c/ Limite (${mult}x): ${limite}s`, corStatus, "color: black;");
            console.log(`Último Registro Real: %c${res.timestampUltimaPlaca}`, "color: #e83e8c; font-weight: bold;");
        // --- DENTRO DA verificarTaktAutomatico ---

        // --- 1. LÓGICA DE FECHAMENTO AUTOMÁTICO (RETOMADA) ---
        if (res.paradaEmAberto) {
            const qtdReferenciaBanco = res.quantidadeMomentoParada;
            if (segundosInativoReal < limite && res.meta >0) {
                console.warn(`[WATCHDOG] Produção detectada! Atual(${realizado}) > Banco(${qtdReferenciaBanco}) .`);

                // --- ATUALIZAÇÃO VISUAL IMEDIATA (VERDE) ---
                $('#tileEficiencia').removeClass('alert-stop'); // Remove fundo vermelho/alerta
                $('#motivoParada').text("OPERANDO").removeClass('text-danger'); // Volta texto original

                // Opcional: Forçar a cor do Total Acumulado para verde se a eficiência permitir
                // atualizarCoresEficiencia(realizado, meta, pan);

                console.log(`[WATCHDOG] Finalizando parada ID: ${res.idParada}`);

                // Chama a função de fechar no banco
                finalizarParadaAutomatica(res.idParada, realizado);

                // Sincroniza a variável global e encerra este ciclo
                ultimaQtd = realizado;
                return;
            }
        }

        // --- AÇÃO DE ABERTURA (LINHA PARADA) ---
        // Adicionamos a checagem da trava 'emTransicaoDeBipe'
        if (segundosInativoReal >= limite && res.meta > 0 && !emTransicaoDeBipe) {

            // Só entra se NÃO houver parada no banco (segundo o último res)
            // E se a nossa variável de controle local estiver limpa
            if (!res.paradaEmAberto && idParadaAtualAtiva === null) {

                idParadaAtualAtiva = "PENDING";

                console.warn(`[WATCHDOG] Takt excedido (${segundosInativoReal}s). Solicitando abertura...`);

                registrarParadaAutomatica(
                    linha,
                    res.produto,
                    ladoIdentificado,
                    "INATIVIDADE AUTOMATICA ",
                    res.timestampUltimaPlaca
                );
            }
        } else if (emTransicaoDeBipe) {
            // Log apenas para você ver no console que a trava funcionou
            console.log("[WATCHDOG] Abertura automática bloqueada por transição de Bipe.");
        }

            console.groupEnd();
            ultimaQtd = realizado;
        }



        function obterParadaAtiva(paradas) {
            if (!paradas || paradas.length === 0) return null;

            const agora = new Date();
            const diaSemana = agora.getDay(); // 0 = Domingo, 1 = Segunda, ..., 6 = Sábado

            const horaAtual = agora.getHours().toString().padStart(2, '0') + ":" +
                             agora.getMinutes().toString().padStart(2, '0');

            // Mapeamento do dia do JS para a propriedade que vem do C#
            const diasMap = ["dom", "seg", "ter", "qua", "qui", "sex", "sab"];
            const hojeProp = diasMap[diaSemana];

            return paradas.find(p => {
                // Verifica se o horário bate E se o checkbox do dia atual estava marcado
                const estaNoHorario = (horaAtual >= p.inicio && horaAtual <= p.fim);
                const aplicaHoje = p[hojeProp] === true;

                return estaNoHorario && aplicaHoje;
            });
        }


