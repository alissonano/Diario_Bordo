@{
    ViewData["Title"] = "Importar Stencils";
}

<div class="container mt-4">
    <h3 class="mb-3 text-secondary">📂 Importar Stencils</h3>

    <form asp-action="Import" asp-controller="Stencil" method="post" enctype="multipart/form-data" class="border rounded p-4 bg-light">
        <div class="mb-3">
            <label for="arquivo" class="form-label fw-semibold">Selecione o arquivo (.xlsx ou .txt)</label>
            <input type="file" id="arquivo" name="arquivo" class="form-control" accept=".xlsx,.txt" required />
        </div>

        <div class="d-flex justify-content-end">
            <button type="submit" class="btn btn-success">📥 Importar</button>
        </div>
    </form>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success mt-3">@TempData["SuccessMessage"]</div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger mt-3">@TempData["ErrorMessage"]</div>
    }

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">← Voltar</a>
    </div>
</div>
