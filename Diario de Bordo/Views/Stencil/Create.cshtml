@model Diario_de_Bordo.Models.Stencil

@{
    ViewData["Title"] = "Cadastrar Stencil";
}

<div class="container mt-4">
    <h4 class="mb-3">📋 Cadastrar Novo Stencil</h4>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <form asp-action="Create" method="post" class="needs-validation" novalidate>
        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="num_stencil" class="form-label">Número do Stencil</label>
                <input asp-for="num_stencil" class="form-control" required />
                <span asp-validation-for="num_stencil" class="text-danger"></span>
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="descricao" class="form-label">Descrição</label>
                <input asp-for="descricao" class="form-control" />
                <span asp-validation-for="descricao" class="text-danger"></span>
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="cliente" class="form-label">Cliente</label>
                <input asp-for="cliente" class="form-control" />
                <span asp-validation-for="cliente" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="fabricante" class="form-label">Fabricante</label>
                <input asp-for="fabricante" class="form-control" />
                <span asp-validation-for="fabricante" class="text-danger"></span>
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="cod_fabricante" class="form-label">Código do Fabricante</label>
                <input asp-for="cod_fabricante" class="form-control" />
                <span asp-validation-for="cod_fabricante" class="text-danger"></span>
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="data_fabricacao" class="form-label">Data de Fabricação</label>
                <input asp-for="data_fabricacao" class="form-control" placeholder="dd/mm/aaaa" />
                <span asp-validation-for="data_fabricacao" class="text-danger"></span>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">💾 Salvar</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">↩ Voltar</a>
    </form>

    <div class="mt-3">
        <partial name="_ValidationScriptsPartial" />
    </div>
</div>
