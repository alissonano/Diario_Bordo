@model Diario_de_Bordo.Models.CQViewModel

@{
    bool isCQAdmin = Model.IsCQAdmin;
    ViewData["Title"] = "Nova Inspeção - Checklist";
    ViewBag.StatusGeral = new SelectList(new[] { "Aguardando Confirmação", "Aprovado", "Reprovado" }, Model.Inspecao.Status);

}

<h3>Inspeção @Model.Inspecao.Id - @Model.Inspecao.Cliente / @Model.Inspecao.Modelo</h3>
<p>
    <strong>OP:</strong> @Model.Inspecao.OP |
    <strong>Fase:</strong> @Model.Inspecao.Fase |
    <strong>Turno:</strong> @Model.Inspecao.Turno
</p>
<hr />

<form asp-action="SalvarChecklist" method="post">
    <input type="hidden" name="Inspecao.Id" value="@Model.Inspecao.Id" />

    <div class="mb-3 row">
        <label class="col-sm-2 col-form-label fw-bold">Status:</label>
        <div class="col-sm-4 col-md-3">
            <!-- controla o tamanho do container -->
            <select id="dropdownStatus" name="Inspecao.Status" class="form-select"></select>
        </div>

        <label class="col-sm-2 col-form-label fw-bold">Comentário Geral:</label>
        <div class="col-sm-4">
            <input type="text" name="Inspecao.ComentarioGeral" class="form-control" value="@Model.Inspecao.ComentarioGeral" />
        </div>
    </div>

    <table class="table table-bordered table-striped align-middle" style="font-size:0.9rem;">
        <thead class="table-light">
            <tr>
                <th>Posto</th>
                <th>Item</th>
                <th>Resultado</th>
                <th>Evidências / Comentários</th>
            </tr>
        </thead>
        <tbody>
            @for (int p = 0; p < Model.Postos.Count; p++)
            {
                var posto = Model.Postos[p];
                var itemCount = posto.Itens.Count;

                for (int i = 0; i < itemCount; i++)
                {
                    var item = posto.Itens[i];
                    <tr>
                        @if (i == 0)
                        {
                            <td rowspan="@itemCount"><strong>@posto.Posto</strong></td>
                        }

                        <td>@item.Nome</td>

                        <td>
                            <span id="badge-@p-@i" class="badge @(item.Resultado == "OK" ? "bg-success" : item.Resultado == "NG" ? "bg-danger" : "bg-secondary")">
                                @item.Resultado
                            </span>
                            <input type="hidden" name="Postos[@p].Itens[@i].Resultado" id="input-@p-@i" value="@item.Resultado" />
                        </td>

                        <td>
                            <button type="button" class="btn btn-sm btn-primary w-100 abrir-modal-btn"
                                    data-cq="@Model.Inspecao.Id"
                                    data-posto="@posto.Posto"
                                    data-item="@item.Nome"
                                    data-resultado="@item.Resultado"
                                    data-pos="@p-@i">
                                Evidências / Comentários
                            </button>

                            <div id="preview-@p-@i" class="d-flex flex-wrap mt-1">
                                @foreach (var ev in item.EvidenciasSalvas ?? new List<Diario_de_Bordo.Models.CQEvidencia>())
                                {
                                    if (!string.IsNullOrEmpty(ev.evidencia))
                                    {
                                        <div class="miniatura-wrapper me-1 mb-1 position-relative">
                                            <img src="@Url.Action("MostrarEvidencia", "CQ", new { id = ev.id })"
                                                 class="miniatura-evidencia"
                                                 style="width:60px;height:60px;object-fit:cover;border-radius:5px;cursor:pointer;"
                                                 onclick="abrirImagemModal('@Url.Action("MostrarEvidencia", "CQ", new { id = ev.id })')" />
                                            <button type="button" class="btn btn-sm btn-danger position-absolute top-0 end-0 p-0"
                                                    style="border-radius:50%; width:18px; height:18px; font-size:12px;"
                                                    onclick="removerMiniatura(this, '@ev.id')">
                                                &times;
                                            </button>
                                        </div>
                                    }
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <div class="mt-3 d-flex justify-content-between">
        <button type="submit" class="btn btn-success">💾 Salvar Checklist</button>

        <button type="button" class="btn btn-primary" onclick="gerarExcel(@Model.Inspecao.Id)">
            📄 Exportar para Excel
        </button>

    </div>
</form>

<!-- MODAL -->
<div class="modal fade" id="modalEvidencia" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title">Evidências - <span id="tituloModal"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-bold">Resultado:</label>
                    <select id="resultadoModal" class="form-select">
                        <option value="N/A">N/A</option>
                        <option value="OK">OK</option>
                        <option value="NG">NG</option>
                    </select>
                </div>

                <div id="listaImagens" class="mb-3 row"></div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Comentários:</label>
                    <ul id="listaComentarios" class="list-group small"></ul>
                </div>

                <textarea id="novoComentario" class="form-control mb-2" placeholder="Escreva um comentário..."></textarea>
                <input type="file" id="novasImagens" multiple class="form-control mb-3" accept="image/*" capture="environment" />
            </div>

            <div class="modal-footer">
                <button class="btn btn-success" onclick="salvarEvidencias()">💾 Salvar Evidências</button>
                <button class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL DE ESPERA (GERANDO EXCEL) -->
<div class="modal fade" id="loadingExcelModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-center p-4">
            <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;"></div>
            <h5>Gerando arquivo Excel...</h5>
            <p class="text-muted">Aguarde alguns segundos.</p>
        </div>
    </div>
</div>




@section Scripts {
<script>

        function gerarExcel(id) {
            // Abre a modal imediatamente
            var modal = new bootstrap.Modal(document.getElementById('loadingExcelModal'));
            modal.show();

            // Cria link de download
            const link = document.createElement("a");
            link.href = "/CQ/ExportarXLSX?id=" + id;
            link.download = "";
            document.body.appendChild(link);

            // Dispara download
            link.click();

            // Remove link temporário
            document.body.removeChild(link);

            // Fecha modal depois de alguns segundos (caso arquivo baixe rápido)
            setTimeout(() => {
                modal.hide();
            }, 6000);
        }

        document.addEventListener("DOMContentLoaded", function () {
            var dropdown = document.getElementById('dropdownStatus');

            // Limpa opções existentes
            dropdown.innerHTML = '';

            // Pega o último status da inspeção do Model
            var statusAtual = '@(Model.Inspecao.Status ?? "Aguardando Confirmação")';

            // Sempre disponível
            var defaultOption = document.createElement('option');
            defaultOption.value = 'Aguardando';
            defaultOption.text = 'Aguardando Confirmação';
            if (statusAtual === "Aguardando Confirmação") defaultOption.selected = true;
            dropdown.add(defaultOption);

            // Opções CQAdmin
            @if (Model.IsCQAdmin)
            {
                    <text>
                    var optAprovado = document.createElement('option');
                    optAprovado.value = 'Aprovado';
                    optAprovado.text = 'Aprovado';
                    if (statusAtual === 'Aprovado') optAprovado.selected = true;
                    dropdown.add(optAprovado);

                    var optReprovado = document.createElement('option');
                    optReprovado.value = 'Reprovado';
                    optReprovado.text = 'Reprovado';
                    if (statusAtual === 'Reprovado') optReprovado.selected = true;
                    dropdown.add(optReprovado);
                    </text>
            }
        });

document.addEventListener("DOMContentLoaded", function () {
    const modalEl = document.getElementById('modalEvidencia');
    const modal = new bootstrap.Modal(modalEl);

    document.querySelectorAll('.abrir-modal-btn').forEach(btn => {
        btn.addEventListener('click', async function () {
            const cqId = btn.dataset.cq;
            const posto = btn.dataset.posto;
            const item = btn.dataset.item;
            const resultado = btn.dataset.resultado || "N/A";
            const pos = btn.dataset.pos;

            window.cqIdAtual = cqId;
            window.postoAtual = posto;
            window.itemAtual = item;
            window.posAtual = pos;

            document.getElementById('tituloModal').innerText = `${posto} - ${item}`;
            document.getElementById('resultadoModal').value = resultado;
            document.getElementById('listaImagens').innerHTML = '<p class="text-muted">Carregando...</p>';
            document.getElementById('listaComentarios').innerHTML = '';

            await carregarEvidencias();
            await carregarComentarios();

            modal.show();
        });
    });

    modalEl.addEventListener('hidden.bs.modal', () => {
        // Badge e input já foram atualizados ao salvar, não precisa recarregar toda a tabela
    });
});

async function carregarEvidencias() {
    const resp = await fetch(`/CQ/ListarEvidencias?cqId=${window.cqIdAtual}&posto=${encodeURIComponent(window.postoAtual)}&item=${encodeURIComponent(window.itemAtual)}`);
    const data = resp.ok ? await resp.json() : [];
    const evidencias = data.evidencias || [];
    const ultimoResultado = data.ultimoResultado || "N/A";

    document.getElementById('resultadoModal').value = ultimoResultado;

    const lista = document.getElementById('listaImagens');
    if (!lista) return;

    if (evidencias.length === 0) {
        lista.innerHTML = '<p class="text-muted">Nenhuma evidência anexada.</p>';
        return;
    }

    lista.innerHTML = evidencias.filter(e => e.temArquivo).map(e => `
        <div class="col-md-4 mb-2 text-center">
            <img src="/CQ/MostrarEvidencia/${e.id}" class="img-fluid rounded shadow-sm"
                 onclick="abrirImagemModal('/CQ/MostrarEvidencia/${e.id}')" />
            <button class="btn btn-sm btn-danger mt-1" onclick="excluirEvidencia(${e.id})">Excluir</button>
        </div>
    `).join('');
}

        async function carregarComentarios() {
            try {
                const resp = await fetch(`/CQ/ListarComentarios?cqId=${window.cqIdAtual}&posto=${encodeURIComponent(window.postoAtual)}&item=${encodeURIComponent(window.itemAtual)}`);
                const comentarios = resp.ok ? await resp.json() : [];
                const lista = document.getElementById('listaComentarios');

                // Filtra apenas comentários que não são vazios ou null
                const comentariosValidos = comentarios.filter(c => c && c.trim() !== "");

                if (comentariosValidos.length === 0) {
                    lista.innerHTML = '<li class="list-group-item text-muted">Sem comentários.</li>';
                } else {
                    lista.innerHTML = comentariosValidos
                        .map(c => `<li class="list-group-item">${c}</li>`)
                        .join('');
                }
            } catch (erro) {
                console.error("Erro ao carregar comentários:", erro);
            }
        }

async function salvarEvidencias() {
    const comentario = document.getElementById('novoComentario').value.trim();
    const arquivos = document.getElementById('novasImagens').files;
    const resultado = document.getElementById('resultadoModal').value;

   // if (!comentario && arquivos.length === 0) {
   //     alert('Adicione um comentário ou selecione ao menos uma imagem.');
   //     return;
   // }

    const formData = new FormData();
    formData.append('cqId', window.cqIdAtual);
    formData.append('posto', window.postoAtual);
    formData.append('itemNome', window.itemAtual);
    formData.append('comentario', comentario);
    formData.append('resultado', resultado);

    for (let i = 0; i < arquivos.length; i++) formData.append('arquivos', arquivos[i]);

    try {
        const resp = await fetch('/CQ/UploadEvidencias', { method: 'POST', body: formData });
        const json = await resp.json();

        if (json.sucesso) {
            document.getElementById('novoComentario').value = '';
            document.getElementById('novasImagens').value = '';

            // Atualiza badge e input do formulário
            const badge = document.getElementById(`badge-${window.posAtual}`);
            const input = document.getElementById(`input-${window.posAtual}`);
            if (badge && input) {
                badge.textContent = resultado;
                badge.className = "badge " + (resultado === "OK" ? "bg-success" : resultado === "NG" ? "bg-danger" : "bg-secondary");
                input.value = resultado;
            }

            await carregarEvidencias();
            await carregarComentarios();
            alert('Evidência salva com sucesso!');
        } else {
            alert('Erro: ' + json.mensagem);
        }
    } catch (erro) {
        console.error(erro);
        alert('Erro ao salvar evidência.');
    }
}

async function excluirEvidencia(id) {
    if (!confirm('Deseja realmente excluir esta evidência?')) return;

    try {
        const resp = await fetch(`/CQ/ExcluirEvidencia/${id}`, { method: 'DELETE' });
        const json = await resp.json();
        if (json.sucesso) await carregarEvidencias();
        else alert('Erro: ' + json.mensagem);
    } catch (erro) {
        console.error(erro);
        alert('Erro ao excluir evidência.');
    }
}
</script>
}