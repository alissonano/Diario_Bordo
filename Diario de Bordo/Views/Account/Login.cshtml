@model Diario_de_Bordo.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />
<link rel="stylesheet" href="~/css/login.css" />

<div class="login-container">
    <img src="~/images/gbr-logo.png" alt="Logo" class="login-logo" />

    @if (!string.IsNullOrEmpty(Model.MensagemErro))
    {
        <div class="text-error">@Model.MensagemErro</div>
    }

    <form asp-action="Login" asp-controller="Account" method="post">
        <div class="mb-3">
            <label asp-for="Matricula" class="form-label">Matrícula</label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-person-fill"></i></span>
                <input asp-for="Matricula" class="form-control" placeholder="Digite sua matrícula" />
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Senha" class="form-label">Senha</label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-key-fill"></i></span>
                <input asp-for="Senha" type="password" class="form-control" placeholder="Digite sua senha" />
            </div>
        </div>

        <button type="submit" class="btn btn-primary"><i class="bi bi-box-arrow-in-right"></i> Entrar</button>
    </form>
</div>

<script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
